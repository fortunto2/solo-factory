{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"solo-factory\": \"loaded\", \"version\": \"1.20.0\", \"skills\": [\"research\", \"validate\", \"scaffold\", \"setup\", \"plan\", \"build\", \"swarm\", \"stream\", \"audit\", \"pipeline\"], \"agents\": [\"researcher\", \"code-analyst\", \"idea-validator\"], \"mcp\": \"codegraph\"}'"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-drift.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sensor-stop.sh",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pipeline-stop.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sensor-edit.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
