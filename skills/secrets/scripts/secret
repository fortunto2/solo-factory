#!/usr/bin/env python3
"""secret — credentials in the OS keystore, metadata in a registry, plaintext found and moved.

    secret set <name> [--class C --rotate-days N --scope S --used-in P --rotate-url U --note T]
                                   value from stdin or a hidden prompt, never from argv
    secret add <name> [same flags as set]   metadata only: an item already in the keystore,
                                   or a credential tracked for rotation but stored elsewhere
    secret get <name>              value to stdout, for piping: TOKEN="$(secret get x)"
    secret exec A=ENV [B=ENV2] -- cmd args    run one command with the values in its env
    secret list                    metadata only, and whether the keystore holds the item
    secret rotate <name> [--revoked]   where to rotate, then the new value, then the next due date
    secret leak <name> --where W   mark a value as seen in a log/chat/screenshot: due now
    secret due                     rotation overdue / due within 30 days; exit 1 when overdue
    secret scan [paths] [--json] [--min high] [--exclude GLOB]   plaintext secrets, masked
    secret migrate <file> <key> <name> [--class C] [--remove]
                                   move a value from a config file into the keystore
    secret check [paths]           one counted line for a recurring health check

Backends: macOS Keychain (`security`, generic password, service=<name>, account=$USER),
Linux libsecret (`secret-tool`). SECRETS_BACKEND=file + SECRETS_FILE_STORE=<dir> is a
plaintext store for tests only.
Registry (no values, safe to commit): $SECRETS_REGISTRY, default
~/.config/secrets/registry.json.
Values are never printed except by `get`; everything else shows the first 4 characters
and the length.
"""

from __future__ import annotations

import argparse
import base64
import fnmatch
import getpass
import hashlib
import json
import math
import os
import re
import shutil
import subprocess
import sys
from datetime import date, timedelta
from pathlib import Path

CLASSES = {  # policy class -> rotation period in days (0 = rotate now)
    "prod-admin": 90,
    "api-scoped": 180,
    "personal-low": 365,
    "leaked": 0,
}
DEFAULT_CLASS = "api-scoped"
SOON_DAYS = 30

# --- detection rules -------------------------------------------------------------------
# AI-NOTE: keep TOKEN_RULES a superset of hooks/secret_guard.py TOKEN_RULES (tests/secrets.bats checks the names)
TOKEN_RULES = [
    ("private-key-block", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("anthropic-key", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}")),
    ("openai-key", re.compile(r"\bsk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{32,}")),
    ("aws-access-key", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    (
        "github-token",
        re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,})"),
    ),
    ("gitlab-token", re.compile(r"\bglpat-[A-Za-z0-9_-]{20,}")),
    ("stripe-live-key", re.compile(r"\b[sr]k_live_[0-9a-zA-Z]{20,}")),
    ("slack-token", re.compile(r"\bxox[baprs]-[0-9A-Za-z-]{10,}")),
    ("google-api-key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}")),
    ("huggingface-token", re.compile(r"\bhf_[A-Za-z0-9]{34,}")),
    ("telegram-bot-token", re.compile(r"\b\d{8,10}:AA[A-Za-z0-9_-]{33}\b")),
    ("cloudflare-token", re.compile(r"\bcf(?:ut|at|k)_[A-Za-z0-9_-]{30,}")),
    ("npm-token", re.compile(r"\bnpm_[A-Za-z0-9]{36}\b")),
    ("pypi-token", re.compile(r"\bpypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{50,}")),
    ("sendgrid-key", re.compile(r"\bSG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}\b")),
    ("stripe-webhook-secret", re.compile(r"\bwhsec_[A-Za-z0-9+/=]{24,}")),
    ("resend-key", re.compile(r"\bre_[A-Za-z0-9]{8}_[A-Za-z0-9]{20,}")),
    (
        "jwt",
        re.compile(
            r"\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"
        ),
    ),
]
# Python's re finds a literal-prefixed pattern ~15x faster than one that starts with \b,
# so the scan runs the rules without it and checks the boundary by hand. Telegram's
# token starts with digits: find ":AA…" and look back for the 8-10 digit bot id.
SCAN_RULES = [
    (r, re.compile(rx.pattern[2:]) if rx.pattern.startswith(r"\b") else rx)
    for r, rx in TOKEN_RULES
    if r != "telegram-bot-token"
]
TG_TAIL = re.compile(r":AA[A-Za-z0-9_-]{33}\b")
TG_HEAD = re.compile(r"(?<!\d)\d{8,10}$")
NAME_WORDS = re.compile(r"secret|token|passw|pwd|passphrase|credential|key|hash")
DSN_RULE = re.compile(
    r"\b(?:postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis|amqp)://[^\s:/@]+:([^\s@/]{4,})@"
)
ASSIGN = re.compile(
    r"""^\s*(?:export\s+|(?:const|let|var|final|static|private|public)\s+)*["']?"""
    r"""([A-Za-z_][A-Za-z0-9_.\-]*)["']?\s*(?::=|=|:)\s*(.+?)\s*[,;]?\s*$"""
)
SECRET_WORDS = {
    "secret", "secrets", "token", "password", "passwd", "pwd", "apikey", "passphrase",
    "credential", "credentials",
}  # fmt: skip
SECRET_PAIRS = {
    ("api", "key"), ("access", "key"), ("private", "key"), ("secret", "key"),
    ("signing", "key"), ("api", "hash"), ("client", "secret"), ("auth", "key"),
    ("master", "key"), ("encryption", "key"), ("service", "key"), ("license", "key"),
}  # fmt: skip
NOT_A_VALUE_SUFFIX = {
    "url", "uri", "endpoint", "path", "file", "dir", "name", "id", "type", "count",
    "limit", "length", "expires", "expiry", "ttl", "header", "field", "env", "var",
    "prefix", "kind", "max", "min", "mode", "enabled", "required", "label", "hint",
    "placeholder", "keychain", "service", "account", "source", "ref", "len", "size",
}  # fmt: skip
PLACEHOLDER = re.compile(
    r"(?i)x{3,}|\*{3,}|your|example|changeme|change_me|placeholder|dummy|redacted|todo|"
    r"<|>|\$|\{|\}|\(|\)|\[|\]|\.\.\.|process\.env|os\.environ|getenv|keychain|"
    r"^(?:none|null|nil|true|false|undefined|required|optional|secret|password|token)$"
)
IDENTIFIER = re.compile(
    r"[A-Z][A-Z0-9_]*|[a-z]+(?:[A-Z][a-z]+)+|[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)+"
)
# Tests, docs, examples and translations hold sample values by the hundred: there the
# name=value heuristic only counts a long high-entropy value. Prefixed tokens count anywhere.
LOW_TRUST = re.compile(
    r"(?i)(?:^|/)(?:tests?|__tests__|specs?|fixtures?|testdata|mocks?|docs?|examples?|"
    r"samples?|locales?|i18n|translations)/|(?:[._-](?:test|spec|e2e|mock)s?\.[a-z]+$)|"
    r"(?:/test_[^/]+$)|\.(?:md|mdx|txt|rst)$"
)
# Cheap whole-file gate: a file with none of these (lowercased) substrings is not scanned.
PREFILTER = (
    "secret", "token", "passw", "pwd", "key", "credential", "hash", "://", "akia", "asia",
    "aiza", "eyj", "sk-", "gh", "github_pat", "xox", "glpat-", "hf_", "cfut_", "cfat_", "cfk_",
    "npm_", "pypi-", "sg.", "re_", ":aa", "whsec_", "private",
)  # fmt: skip
CODE_EXT = {
    ".py", ".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx", ".swift", ".kt", ".kts", ".java",
    ".go", ".rs", ".rb", ".php", ".cs", ".dart", ".vue", ".svelte", ".astro",
}  # fmt: skip
CONFIG_EXT = {
    ".env", ".yaml", ".yml", ".toml", ".json", ".ini", ".cfg", ".conf", ".properties",
    ".xcconfig", ".plist", ".sh", ".bash", ".zsh", ".fish", ".tf", ".tfvars", ".gradle",
    ".md", ".txt", ".netrc", ".npmrc", ".pypirc", ".mk",
}  # fmt: skip
CONFIG_NAMES = {
    "Makefile",
    "Dockerfile",
    ".npmrc",
    ".pypirc",
    ".netrc",
    "env",
    ".envrc",
}
KEY_FILE_GLOBS = [
    ("apple-api-key", "AuthKey_*.p8"),
    ("private-key-file", "*.p8"),
    ("private-key-file", "*.pem"),
    ("private-key-file", "*.key"),
    ("private-key-file", "id_rsa"),
    ("private-key-file", "id_ed25519"),
    ("keystore", "*.p12"),
    ("keystore", "*.pfx"),
    ("keystore", "*.jks"),
    ("keystore", "*.keystore"),
    ("service-account", "*service-account*.json"),
    ("service-account", "*serviceAccount*.json"),
    ("token-file", "*token*.txt"),
]
EXAMPLE_FILE = re.compile(
    r"(?i)\.(example|sample|template|dist|tmpl)$|\.example\.|-example\."
)
SKIP_DIRS = {
    ".git", "node_modules", ".venv", "venv", "__pycache__", ".next", "dist", "build",
    "target", ".build", "DerivedData", "Pods", ".gradle", ".cache", ".turbo", ".pnpm-store",
    "site-packages", ".mypy_cache", ".ruff_cache", ".pytest_cache", "coverage", ".svelte-kit",
    ".astro", ".terraform", ".idea", ".vscode", ".worktrees", ".tox", "bower_components",
    "python_modules", "SourcePackages", ".output", ".vercel", ".netlify", ".wrangler", "xcuserdata", ".swiftpm",
}  # fmt: skip
SKIP_FILES = {"package-lock.json", "pnpm-lock.yaml", "yarn.lock", "uv.lock", "Cargo.lock",
              "poetry.lock", "Podfile.lock", "Package.resolved", "go.sum", "composer.lock"}  # fmt: skip
MAX_BYTES = 1_000_000
ALLOW_MARK = re.compile(r"secret-scan:\s*ignore|pragma:\s*allowlist secret")
SEVERITY = ["critical", "high", "medium", "low"]
# Read before `-C`: an inherited GIT_DIR (a git hook, a parent tool) would make every
# where/tracked answer about another repository, and `gh` would ask about another repo.
REDIRECTORS = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GH_REPO")


def clean_env() -> dict[str, str]:
    return {k: v for k, v in os.environ.items() if k not in REDIRECTORS}


def mask(v: str) -> str:
    return f"{v[:4]}…({len(v)})"


def vid(v: str) -> str:
    return hashlib.sha256(v.encode()).hexdigest()[:8]


def entropy(s: str) -> float:
    if not s:
        return 0.0
    n = len(s)
    return -sum(c / n * math.log2(c / n) for c in (s.count(ch) for ch in set(s)))


def name_is_secret(name: str) -> bool:
    segs = [
        s
        for s in re.split(r"[_.\-]+|(?<=[a-z0-9])(?=[A-Z])", name)
        if s  # split snake, kebab, dotted and camelCase
    ]
    segs = [s.lower() for s in segs]
    if not segs or segs[-1] in NOT_A_VALUE_SUFFIX:
        return False
    if any(s in SECRET_WORDS for s in segs):
        return True
    return any(p in SECRET_PAIRS for p in zip(segs, segs[1:], strict=False))


def value_is_secret(raw: str, code: bool, strict: bool = False) -> str | None:
    """The literal secret in an assigned value, or None for references and placeholders."""
    raw = raw.strip()
    quoted = len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'`"
    if code and not quoted:
        return None
    v = raw[1:-1] if quoted else raw.split(" #")[0].strip()
    if len(v) < 8 or " " in v or v.isdigit() or "://" in v or v[0] in "/~.":
        return None
    if IDENTIFIER.fullmatch(v):  # GEMINI_API_KEY, config.apiToken: a name, not a value
        return None
    if strict and not (
        len(v) >= 20
        and entropy(v) >= 3.5
        and re.search(r"\d", v)
        and re.search(r"[A-Za-z]", v)
    ):
        return None
    if (
        PLACEHOLDER.search(v)
        or v.startswith("@")
        or re.fullmatch(r"[a-z]+([_-][a-z]+)*", v)
    ):
        return None
    classes = sum(
        bool(re.search(p, v)) for p in (r"[a-z]", r"[A-Z]", r"\d", r"[^A-Za-z0-9]")
    )
    if len(v) >= 16:
        return v if entropy(v) >= 3.0 and classes >= 2 else None
    return v if classes >= 2 and entropy(v) >= 2.5 else None


def jwt_note(tok: str) -> str:
    try:
        part = tok.split(".")[1]
        claims = json.loads(base64.urlsafe_b64decode(part + "=" * (-len(part) % 4)))
    except (ValueError, IndexError):
        return ""
    role = str(claims.get("role", ""))
    return f"role={role}" if role else ""


def scan_text(text: str, code: bool, strict: bool = False) -> list[dict]:
    """Findings in one file's text: rule, line, key name, value (caller masks it).
    strict = a test/doc/example file: name=value hits need a long high-entropy value.

    Every regex runs over the whole text (one C loop each) and line numbers are
    computed only for hits: a line-by-line pass made a scan of ~80k files take minutes."""
    out: list[dict] = []
    low = text.lower()
    if not any(w in low for w in PREFILTER):
        return out

    def line_at(pos: int) -> tuple[int, str]:
        start = text.rfind("\n", 0, pos) + 1
        end = text.find("\n", pos)
        return text.count("\n", 0, pos) + 1, text[
            start : end if end >= 0 else len(text)
        ]

    def usable(line: str) -> bool:
        return len(line) <= 4000 and not ALLOW_MARK.search(line)

    seen: set[str] = set()

    def add(rule: str, i: int, v: str, key: str = "", note: str = "") -> None:
        seen.add(v)
        out.append({"rule": rule, "line": i, "key": key, "value": v, "note": note})

    def bounded(pos: int) -> bool:
        return pos == 0 or not (text[pos - 1].isalnum() or text[pos - 1] == "_")

    hits: list[tuple[str, int, str]] = []
    for rule, rx in SCAN_RULES:
        hits += [
            (rule, m.start(), m.group(0))
            for m in rx.finditer(text)
            if bounded(m.start())
        ]
    for m in TG_TAIL.finditer(text):
        head = TG_HEAD.search(text, max(0, m.start() - 11), m.start())
        if head and bounded(head.start()):
            hits.append(
                ("telegram-bot-token", head.start(), head.group(0) + m.group(0))
            )
    for rule, pos, v in hits:
        if v in seen or (rule == "aws-access-key" and "EXAMPLE" in v):
            continue
        if rule in ("openai-key", "jwt") and not re.search(r"\d", v):
            continue
        i, line = line_at(pos)
        if usable(line):
            add(rule, i, v, note=jwt_note(v) if rule == "jwt" else "")
    for m in DSN_RULE.finditer(text):
        v = m.group(1)
        if v in seen or PLACEHOLDER.search(v):
            continue
        i, line = line_at(m.start())
        if usable(line):
            add("dsn-password", i, v)
    last = -1
    for w in NAME_WORDS.finditer(
        low
    ):  # ASSIGN only on lines that hold a secret-ish word
        start = text.rfind("\n", 0, w.start()) + 1
        if start == last:
            continue
        last = start
        i, line = line_at(start)
        m = ASSIGN.match(line)
        if not m or not name_is_secret(m.group(1)) or not usable(line):
            continue
        v = value_is_secret(m.group(2), code, strict)
        if v and not any(v in s or s in v for s in seen):
            add("assigned-secret", i, v, key=m.group(1))
    out.sort(key=lambda h: h["line"])
    return out


# --- git context -----------------------------------------------------------------------
class Git:
    def __init__(self, gh: bool = False):
        self.roots: dict[Path, Path | None] = {}
        self.tracked: dict[Path, set[str]] = {}
        self.remote: dict[Path, str] = {}
        self.gh = gh and shutil.which("gh") is not None

    def root(self, d: Path) -> Path | None:
        chain = []
        cur = d
        while cur not in self.roots:
            chain.append(cur)
            if (cur / ".git").exists():
                self.roots[cur] = cur
                break
            if cur.parent == cur:
                self.roots[cur] = None
                break
            cur = cur.parent
        r = self.roots[cur]
        for c in chain:
            self.roots[c] = r
        return r

    def _git(self, root: Path, *args: str, stdin: str | None = None) -> str:
        r = subprocess.run(
            ["git", "-C", str(root), *args], input=stdin, capture_output=True, text=True,
            check=False, env=clean_env(),
        )  # fmt: skip
        return r.stdout

    def where(self, f: Path) -> tuple[str, Path | None]:
        root = self.root(f.parent)
        if root is None:
            return "no-git", None
        if root not in self.tracked:
            self.tracked[root] = set(self._git(root, "ls-files", "-z").split("\0"))
        rel = str(f.relative_to(root))
        if rel in self.tracked[root]:
            return "tracked", root
        ignored = (
            subprocess.run(
                ["git", "-C", str(root), "check-ignore", "-q", rel], capture_output=True,
                check=False, env=clean_env(),
            ).returncode == 0
        )  # fmt: skip
        return ("ignored" if ignored else "untracked"), root

    def remote_of(self, root: Path) -> str:
        if root not in self.remote:
            url = self._git(root, "remote", "get-url", "origin").strip()
            vis = ""
            m = re.search(r"github\.com[:/]([^/]+/[^/.]+?)(?:\.git)?$", url)
            if self.gh and m:
                vis = subprocess.run(
                    ["gh", "repo", "view", m.group(1), "--json", "visibility", "-q", ".visibility"],
                    capture_output=True, text=True, check=False, timeout=20, env=clean_env(),
                ).stdout.strip()  # fmt: skip
            self.remote[root] = f"{url} {vis}".strip()
        return self.remote[root]


def severity(rule: str, where: str, note: str, remote: str) -> str:
    """tracked = already copied to every clone; untracked = one `git add -A` away;
    ignored / outside git = plaintext on disk, still to move into the keystore."""
    if note == "role=anon":  # Supabase anon key: public by design, RLS is the boundary
        return "low"
    strong = rule not in ("assigned-secret", "token-file")
    if where == "tracked":
        return "critical" if strong or "PUBLIC" in remote else "high"
    if where == "untracked":
        return "high"
    return "medium"


def iter_files(paths: list[Path], exclude: list[str]):
    rx = (
        re.compile("|".join(fnmatch.translate(g) for g in exclude)) if exclude else None
    )
    for p in paths:
        if p.is_file():
            yield p
            continue
        for dirpath, dirs, files in os.walk(p):
            dirs[:] = [
                d for d in dirs
                if d not in SKIP_DIRS
                and not (rx and (rx.match(d) or rx.match(f"{dirpath}/{d}")))
            ]  # fmt: skip
            for fn in files:
                if fn in SKIP_FILES:
                    continue
                f = f"{dirpath}/{fn}"
                if rx and rx.match(f):
                    continue
                yield Path(f)


def file_kind(f: Path) -> str | None:
    """'code', 'config', a key-file rule name, or None to skip."""
    name = f.name
    for rule, g in KEY_FILE_GLOBS:
        if fnmatch.fnmatch(name, g):
            return "keyfile:" + rule
    if name == ".env" or name.startswith(".env.") or name.endswith(".env"):
        return None if EXAMPLE_FILE.search(name) else "config"
    if EXAMPLE_FILE.search(name):
        return None
    ext = f.suffix.lower()
    if ext in CODE_EXT:
        return "code"
    if ext in CONFIG_EXT or name in CONFIG_NAMES:
        return "config"
    return None


def scan(
    paths: list[Path],
    exclude: list[str],
    gh: bool = False,
    owners: list[str] | None = None,
) -> list[dict]:
    """owners: remote substrings that are yours (e.g. "github.com/example-org/"). A tracked
    hit in a clone of someone else's repo is their fixture or their leak: reported low."""
    git = Git(gh)
    found: list[dict] = []
    for f in iter_files(paths, exclude):
        kind = file_kind(f)
        if kind is None:
            continue
        try:
            if f.is_symlink() or f.stat().st_size > MAX_BYTES:
                continue
        except OSError:
            continue
        hits: list[dict] = []
        if kind.startswith("keyfile:"):
            hits.append(
                {"rule": kind[8:], "line": 0, "key": "", "value": "", "note": "file"}
            )
        else:
            try:
                text = f.read_text(errors="strict")
            except (UnicodeDecodeError, OSError):
                continue
            hits = scan_text(text, kind == "code", bool(LOW_TRUST.search(str(f))))
        if not hits:
            continue
        where, root = git.where(f)
        remote = git.remote_of(root) if root and where == "tracked" else ""
        mode = oct(f.stat().st_mode & 0o777)[2:]
        third = bool(owners and remote and not any(o in remote for o in owners))
        for h in hits:
            v = h.pop("value")
            if third:
                h["note"] = (h["note"] + " third-party").strip()
            h.update(
                file=str(f), where=where, remote=remote, mode=mode,
                masked=mask(v) if v else "", id=vid(v) if v else "",
                severity="low" if third else severity(h["rule"], where, h["note"], remote),
            )  # fmt: skip
            found.append(h)
    found.sort(key=lambda h: (SEVERITY.index(h["severity"]), h["file"], h["line"]))
    return found


# --- keystore backends -----------------------------------------------------------------
def _account() -> str:
    return os.environ.get("USER") or getpass.getuser()


def backend() -> str:
    b = os.environ.get("SECRETS_BACKEND")
    if b:
        return b
    if shutil.which("security"):
        return "keychain"
    if shutil.which("secret-tool"):
        return "libsecret"
    sys.exit(
        "no keystore: need macOS `security` or Linux `secret-tool` (libsecret-tools)"
    )


def store_put(service: str, account: str, value: str, note: str = "") -> None:
    b = backend()
    if b == "keychain":
        # `security -i` reads the command from stdin and -X takes hex: the value never
        # appears in argv (visible in `ps`) and needs no shell quoting.
        note_arg = f' -j "{note.replace(chr(34), "")}"' if note else ""
        cmd = f'add-generic-password -U -a "{account}" -s "{service}"{note_arg} -X {value.encode().hex()}\n'
        r = subprocess.run(
            ["security", "-i"], input=cmd, capture_output=True, text=True
        )
        if r.returncode or "error" in (r.stderr + r.stdout).lower():
            sys.exit(f"keychain write failed for {service}: {r.stderr.strip()[:200]}")
    elif b == "libsecret":
        subprocess.run(
            ["secret-tool", "store", "--label", service, "service", service, "account", account],
            input=value, text=True, check=True,
        )  # fmt: skip
    elif b == "file":
        d = Path(os.environ["SECRETS_FILE_STORE"])
        d.mkdir(parents=True, exist_ok=True)
        (d / f"{service}@{account}").write_text(value)
    else:
        sys.exit(f"unknown SECRETS_BACKEND={b}")


def store_get(service: str, account: str) -> str | None:
    b = backend()
    if b == "keychain":
        cmd = ["security", "find-generic-password", "-a", account, "-s", service, "-w"]
    elif b == "libsecret":
        cmd = ["secret-tool", "lookup", "service", service, "account", account]
    else:
        f = Path(os.environ["SECRETS_FILE_STORE"]) / f"{service}@{account}"
        return f.read_text() if f.exists() else None
    r = subprocess.run(cmd, capture_output=True, text=True, check=False)
    return r.stdout.rstrip("\n") if r.returncode == 0 and r.stdout else None


# --- registry --------------------------------------------------------------------------
def registry_path() -> Path:
    return Path(
        os.environ.get("SECRETS_REGISTRY", "~/.config/secrets/registry.json")
    ).expanduser()


def load_registry() -> dict:
    p = registry_path()
    if not p.exists():
        return {"version": 1, "scan": {"exclude": []}, "secrets": {}}
    return json.loads(p.read_text())


def save_registry(reg: dict) -> None:
    p = registry_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    reg["secrets"] = dict(sorted(reg["secrets"].items()))
    p.write_text(json.dumps(reg, indent=2, ensure_ascii=False) + "\n")


def today() -> date:
    t = os.environ.get("SECRETS_TODAY")
    return date.fromisoformat(t) if t else date.today()


def due_date(e: dict) -> date | None:
    """When the value must be rotated. A leak makes it due on the day it was seen."""
    if e.get("leaked"):
        return date.fromisoformat(e["leaked"]["on"])
    if e.get("class") == "leaked":
        return date.fromisoformat(e.get("created") or today().isoformat())
    days = e.get("rotate_days", CLASSES.get(e.get("class", DEFAULT_CLASS), 180))
    if not days:
        return None
    last = e.get("last_rotated") or e.get("created") or today().isoformat()
    return date.fromisoformat(last) + timedelta(days=int(days))


def is_overdue(e: dict) -> bool:
    d = due_date(e)
    return d is not None and (e.get("class") == "leaked" or d < today())


def entry(reg: dict, name: str) -> dict:
    e = reg["secrets"].get(name)
    if e is None:
        sys.exit(f"no secret '{name}' in {registry_path()} — `secret set {name}` first")
    return e


def read_value(prompt: str) -> str:
    if sys.stdin.isatty():
        v = getpass.getpass(prompt)
    else:
        v = sys.stdin.read()
    v = v.rstrip("\r\n")
    if not v:
        sys.exit("empty value, nothing stored")
    return v


# --- commands --------------------------------------------------------------------------
def register(reg: dict, name: str, a: argparse.Namespace, rotated: bool) -> dict:
    e = reg["secrets"].setdefault(name, {"created": today().isoformat()})
    e.setdefault("service", getattr(a, "service", None) or name)
    e.setdefault("account", getattr(a, "account", None) or _account())
    for k in ("class", "scope", "rotate_url", "note", "rotate_days"):
        v = getattr(a, k.replace("-", "_"), None)
        if v is not None:
            e[k] = v
    e.setdefault("class", DEFAULT_CLASS)
    if getattr(a, "used_in", None):
        e["used_in"] = sorted(set(e.get("used_in", [])) | set(a.used_in))
    if rotated:
        e["last_rotated"] = today().isoformat()
        e.pop("leaked", None)
        if e["class"] == "leaked":
            e["class"] = e.pop("class_before_leak", DEFAULT_CLASS)
    return e


def cmd_set(a: argparse.Namespace) -> None:
    reg = load_registry()
    v = read_value(f"value for {a.name}: ")
    e = register(reg, a.name, a, rotated=False)
    e.setdefault("last_rotated", today().isoformat())
    store_put(e["service"], e["account"], v, e.get("note", ""))
    save_registry(reg)
    print(
        f"stored {a.name}: {mask(v)} in {backend()} (service={e['service']}); due {due_date(e)}"
    )


def cmd_add(a: argparse.Namespace) -> None:
    reg = load_registry()
    e = register(reg, a.name, a, rotated=False)
    save_registry(reg)
    present = store_get(e["service"], e["account"]) is not None
    print(
        f"registered {a.name} ({e['class']}); in {backend()}: {'yes' if present else 'no'}; due {due_date(e)}"
    )


def cmd_get(a: argparse.Namespace) -> None:
    reg = load_registry()
    e = reg["secrets"].get(a.name, {"service": a.name, "account": _account()})
    v = store_get(e["service"], e["account"])
    if v is None:
        sys.exit(f"{a.name}: not in {backend()} (service={e['service']})")
    sys.stdout.write(v + ("\n" if sys.stdout.isatty() else ""))


def cmd_exec(a: argparse.Namespace) -> None:
    if "--" not in a.rest:
        sys.exit("usage: secret exec NAME=ENV [...] -- command args")
    i = a.rest.index("--")
    pairs, cmd = a.rest[:i], a.rest[i + 1 :]
    if not cmd:
        sys.exit("nothing to run after --")
    reg = load_registry()
    env = dict(os.environ)
    for p in pairs:
        name, _, var = p.partition("=")
        e = reg["secrets"].get(name, {"service": name, "account": _account()})
        v = store_get(e["service"], e["account"])
        if v is None:
            sys.exit(f"{name}: not in {backend()}")
        env[var or name.upper().replace("-", "_")] = v
    os.execvpe(cmd[0], cmd, env)


def cmd_list(a: argparse.Namespace) -> None:
    reg = load_registry()
    if a.json:
        print(json.dumps(reg["secrets"], indent=2))
        return
    for name, e in reg["secrets"].items():
        present = (
            "-"
            if a.no_check
            else ("yes" if store_get(e["service"], e["account"]) else "NO")
        )
        d = due_date(e)
        flag = " LEAKED" if e.get("leaked") else ""
        print(
            f"{name:34} {e.get('class', ''):13} due {d or 'never'}  in-store {present}{flag}"
            f"  {', '.join(e.get('used_in', []))[:80]}"
        )


def cmd_due(a: argparse.Namespace) -> int:
    reg = load_registry()
    t = today()
    overdue = 0
    for name, e in sorted(
        reg["secrets"].items(), key=lambda kv: due_date(kv[1]) or date.max
    ):
        d = due_date(e)
        if d is None:
            continue
        left = (d - t).days
        if is_overdue(e):
            overdue += 1
            why = (
                f"leaked: {e['leaked']['where']}"
                if e.get("leaked")
                else f"{-left} days overdue"
            )
            print(f"OVERDUE  {name}  ({why})  rotate: {e.get('rotate_url', '?')}")
        elif left <= a.within:
            print(f"due      {name}  in {left} days ({d})")
    print(f"rotation: {overdue} overdue of {len(reg['secrets'])} registered")
    return 1 if overdue else 0


def cmd_rotate(a: argparse.Namespace) -> None:
    reg = load_registry()
    e = entry(reg, a.name)
    print(f"rotate {a.name}", file=sys.stderr)
    print(
        f"  issue a new value at: {e.get('rotate_url', '(no rotate_url recorded)')}",
        file=sys.stderr,
    )
    print(f"  scope to keep: {e.get('scope', '(not recorded)')}", file=sys.stderr)
    print(
        f"  used in: {', '.join(e.get('used_in', [])) or '(not recorded)'}",
        file=sys.stderr,
    )
    print("  then revoke the old value there.", file=sys.stderr)
    if a.revoked:  # revoked with no replacement: nothing to store
        register(reg, a.name, a, rotated=True)
        save_registry(reg)
        print(f"{a.name}: recorded as revoked, no new value stored")
        return
    v = read_value("new value: ")
    old = store_get(e["service"], e["account"])
    if old == v:
        sys.exit("the new value equals the stored one: nothing was rotated")
    register(reg, a.name, a, rotated=True)
    store_put(e["service"], e["account"], v, e.get("note", ""))
    save_registry(reg)
    print(f"rotated {a.name}: {mask(v)}; next due {due_date(e)}")


def cmd_leak(a: argparse.Namespace) -> None:
    reg = load_registry()
    e = entry(reg, a.name)
    if e.get("class") != "leaked":
        e["class_before_leak"] = e.get("class", DEFAULT_CLASS)
    e["class"] = "leaked"
    e["leaked"] = {"on": today().isoformat(), "where": a.where}
    save_registry(reg)
    print(
        f"{a.name}: marked leaked ({a.where}); `secret rotate {a.name}` once a new value is issued"
    )


def find_key(lines: list[str], key: str) -> tuple[int, str] | None:
    """Line index and raw value of `a.b.c` in YAML (by indentation) or KEY in env/toml/ini."""
    parts = key.split(".")
    depth, indent_stack = 0, [-1]
    for i, line in enumerate(lines):
        s = line.split(" #")[0].rstrip()
        if not s.strip() or s.lstrip().startswith("#"):
            continue
        ind = len(s) - len(s.lstrip())
        while depth and ind <= indent_stack[-1]:
            depth -= 1
            indent_stack.pop()
        m = re.match(
            r"\s*(?:export\s+)?[\"']?([A-Za-z0-9_.\-]+)[\"']?\s*[:=]\s*(.*)$", s
        )
        if not m or m.group(1) != parts[depth]:
            continue
        if depth == len(parts) - 1:
            return i, m.group(2).strip()
        if not m.group(2).strip():
            depth += 1
            indent_stack.append(ind)
    return None


def cmd_migrate(a: argparse.Namespace) -> None:
    f = Path(a.file).expanduser().resolve()
    lines = f.read_text().splitlines(keepends=True)
    hit = find_key(lines, a.key)
    if not hit:
        sys.exit(f"{a.key} not found in {f}")
    i, raw = hit
    v = raw.strip().strip("\"'")
    if not v:
        sys.exit(f"{a.key} in {f} is empty: nothing to migrate")
    reg = load_registry()
    a.used_in = [f"{f}:{a.key}"]
    e = register(reg, a.name, a, rotated=False)
    e.setdefault("last_rotated", today().isoformat())
    store_put(e["service"], e["account"], v, e.get("note", ""))
    if store_get(e["service"], e["account"]) != v:
        sys.exit("read-back from the keystore differs: config left untouched")
    save_registry(reg)
    print(
        f"moved {f.name}:{i + 1} {a.key} = {mask(v)} -> {backend()} service={e['service']}"
    )
    if a.remove:
        lines[i] = re.sub(re.escape(raw) + r"\s*$", '""', lines[i].rstrip("\n")) + "\n"
        f.write_text("".join(lines))
        print(f"blanked the value in {f.name}:{i + 1}")
    else:
        print(
            f"the value is still in {f.name}:{i + 1}; blank it once the code reads the keystore"
        )
    print("\nread it in code (Python, stdlib):")
    print(
        f'    subprocess.run(["security", "find-generic-password", "-a", os.environ["USER"], "-s", '
        f'"{e["service"]}", "-w"], capture_output=True, text=True).stdout.strip()'
    )
    print(f"or inject per command:  secret exec {a.name}=ENV_VAR -- <cmd>")


def scan_paths(given: list[str], reg: dict) -> list[Path]:
    """Explicit paths, else the registry's scan.paths, else the current directory."""
    raw = given or reg.get("scan", {}).get("paths") or ["."]
    return [Path(p).expanduser().resolve() for p in raw]


def cmd_scan(a: argparse.Namespace) -> int:
    reg = load_registry()
    paths = scan_paths(a.paths, reg)
    exclude = list(a.exclude or []) + reg.get("scan", {}).get("exclude", [])
    found = scan(paths, exclude, gh=a.gh, owners=reg.get("scan", {}).get("owners"))
    floor = SEVERITY.index(a.min)
    found = [h for h in found if SEVERITY.index(h["severity"]) <= floor]
    if a.json:
        print(json.dumps(found, indent=2))
    else:
        for h in found:
            loc = f"{h['file']}:{h['line']}" if h["line"] else h["file"]
            extra = " ".join(
                x
                for x in (h["key"], h["masked"], h["id"] and "id=" + h["id"], h["note"])
                if x
            )
            remote = f"  [{h['remote']}]" if h["remote"] else ""
            print(
                f"{h['severity'].upper():8} {h['where']:9} {loc}  {h['rule']}  {extra}{remote}"
            )
    counts = {s: sum(h["severity"] == s for h in found) for s in SEVERITY}
    files = len({h["file"] for h in found})
    print(
        f"scan: {len(found)} findings in {files} files — "
        + ", ".join(f"{counts[s]} {s}" for s in SEVERITY),
        file=sys.stderr if a.json else sys.stdout,
    )
    return 1 if counts["critical"] or counts["high"] else 0


def cmd_check(a: argparse.Namespace) -> int:
    reg = load_registry()
    paths = scan_paths(a.paths, reg)
    sc = reg.get("scan", {})
    found = scan(paths, sc.get("exclude", []), gh=a.gh, owners=sc.get("owners"))
    c = {s: sum(h["severity"] == s for h in found) for s in SEVERITY}
    overdue = sum(is_overdue(e) for e in reg["secrets"].values())
    print(
        f"secrets: {c['critical']} critical, {c['high']} high, {c['medium']} medium plaintext findings; "
        f"{overdue} of {len(reg['secrets'])} registered overdue for rotation"
    )
    return 1 if c["critical"] or c["high"] or overdue else 0


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="secret",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    def meta(sp: argparse.ArgumentParser) -> None:
        sp.add_argument("--service")
        sp.add_argument("--account")
        sp.add_argument("--class", dest="class", choices=sorted(CLASSES))
        sp.add_argument("--rotate-days", type=int)
        sp.add_argument("--scope")
        sp.add_argument("--used-in", action="append")
        sp.add_argument("--rotate-url")
        sp.add_argument("--note")

    s = sub.add_parser("set")
    s.add_argument("name")
    meta(s)
    s = sub.add_parser("add")
    s.add_argument("name")
    meta(s)
    s = sub.add_parser("get")
    s.add_argument("name")
    s = sub.add_parser("exec")
    s.add_argument("rest", nargs=argparse.REMAINDER)
    s = sub.add_parser("list")
    s.add_argument("--json", action="store_true")
    s.add_argument("--no-check", action="store_true", help="skip the keystore lookups")
    s = sub.add_parser("rotate")
    s.add_argument("name")
    s.add_argument(
        "--revoked", action="store_true", help="old value revoked, no replacement"
    )
    s = sub.add_parser("leak")
    s.add_argument("name")
    s.add_argument("--where", required=True)
    s = sub.add_parser("due")
    s.add_argument("--within", type=int, default=SOON_DAYS)
    s = sub.add_parser("scan")
    s.add_argument("paths", nargs="*")
    s.add_argument("--json", action="store_true")
    s.add_argument("--min", choices=SEVERITY, default="low")
    s.add_argument("--exclude", action="append")
    s.add_argument(
        "--gh", action="store_true", help="ask gh whether a GitHub remote is PUBLIC"
    )
    s = sub.add_parser("migrate")
    s.add_argument("file")
    s.add_argument("key")
    s.add_argument("name")
    s.add_argument("--remove", action="store_true")
    meta(s)
    s = sub.add_parser("check")
    s.add_argument("paths", nargs="*")
    s.add_argument("--gh", action="store_true")
    return p


def main() -> None:
    a = parser().parse_args()
    fn = {
        "set": cmd_set,
        "add": cmd_add, "get": cmd_get, "exec": cmd_exec, "list": cmd_list, "rotate": cmd_rotate,
        "leak": cmd_leak, "due": cmd_due, "scan": cmd_scan, "migrate": cmd_migrate, "check": cmd_check,
    }[a.cmd]  # fmt: skip
    rc = fn(a)
    sys.exit(rc or 0)


if __name__ == "__main__":
    main()
