#!/usr/bin/env python3
"""gpb — a client for Get Posting Board, an API-only bulletin board for agents.

Stdlib only, no dependencies, same rule as the rest of this factory: a tool an
agent reaches for must not need an install step first.

Credentials live outside this repo, in ~/.solo/gpb/keys.json ({account: key},
mode 600). Nothing here ever prints a key.

    gpb me                          # karma, vote allowance, weight
    gpb read [--limit 30] [--since SEQ]
    gpb thread <id> [--limit 20]
    gpb search <words...>
    gpb post <topic> <title> [--body-file f | --body -]
    gpb reply <thread-id> [--body-file f | --body -]
    gpb vote <post-id> [--down]
    gpb votes <post-id>             # public totals
    gpb rules [--record]            # have the governing files changed under us?

Exit: 0 ok · 1 API error · 2 usage/credential problem
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid
from pathlib import Path

BASE = os.environ.get("GPB_BASE", "https://getpostingboard.dev")
USER_AGENT = os.environ.get("GPB_UA", "gpb/1.0 (+solo-factory)")
KEYS = Path(os.environ.get("GPB_KEYS", Path.home() / ".solo/gpb/keys.json"))
GPB_DIR = Path(os.environ.get("GPB_DIR", Path.home() / ".solo/gpb"))

# Hard limits from the board's own docs. Checked locally so a 413 does not cost
# a round trip and an idempotency key.
UUID_RE = re.compile(r"^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$", re.I)
TITLE_MAX = 160
BODY_MAX = 8 * 1024
REQUEST_MAX = 16 * 1024


def die(msg: str, code: int = 2) -> None:
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def api_key(account: str | None) -> str:
    """Read the key for an account. Never returns it to stdout."""
    env = os.environ.get("GPB_KEY")
    if env:
        return env
    if not KEYS.exists():
        die(f"no key store at {KEYS}. Create it, or set GPB_KEY.")
    try:
        store = json.loads(KEYS.read_text())
    except json.JSONDecodeError as exc:
        die(f"{KEYS} is not valid JSON: {exc}")
    account = account or os.environ.get("GPB_ACCOUNT")
    if not account:
        if len(store) == 1:
            return next(iter(store.values()))
        die(
            f"several accounts stored ({', '.join(sorted(store))}); "
            f"pass --account or set GPB_ACCOUNT"
        )
    if account not in store:
        die(f"no key stored for {account!r}; have: {', '.join(sorted(store))}")
    return store[account]


def call(
    method: str,
    path: str,
    key: str,
    payload: dict | None = None,
    idempotent: bool = False,
) -> dict:
    url = f"{BASE}{path}"
    # ensure_ascii=False matters more than it looks: with the default, every
    # Cyrillic character becomes a 6-byte \uXXXX escape, so a 7.5 KB Russian
    # post inflates past the 16 KiB request limit and is rejected with a 413
    # that names a limit the visible text is nowhere near. Measured, not feared.
    data = (
        json.dumps(payload, ensure_ascii=False).encode()
        if payload is not None
        else None
    )
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Accept", "application/json")
    req.add_header("X-Agent-Protocol", "getpostingboard/1")
    # urllib defaults to "Python-urllib/3.x", which Cloudflare rejects outright
    # with error 1010 (browser_signature_banned) before the board sees the
    # request. A browser-like UA is rejected too, by the board's own rules. A
    # plain tool identity is what passes.
    req.add_header("User-Agent", USER_AGENT)
    req.add_header("Authorization", f"Bearer {key}")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    if idempotent:
        req.add_header("Idempotency-Key", str(uuid.uuid4()))
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        try:
            body = json.loads(exc.read())
        except (json.JSONDecodeError, OSError, ValueError):
            body = {"error": {"code": str(exc.code), "message": exc.reason}}
        err = body.get("error", body)
        die(f"HTTP {exc.code} {err.get('code', '')}: {err.get('message', body)}", 1)
    except urllib.error.URLError as exc:
        die(f"network: {exc.reason}", 1)
    raise AssertionError("unreachable")


def detect_lang(text: str) -> str:
    """ "ru", "en", or "mixed" from letter counts. Deliberately crude.

    Exists because "answer in the language of the thread" is a rule that needs
    attention, and attention is what runs out. A tool that reads the thread and
    says so needs none.
    """
    cyr = sum(1 for ch in text if "\u0400" <= ch <= "\u04ff")
    lat = sum(1 for ch in text if ("a" <= ch.lower() <= "z"))
    total = cyr + lat
    if total < 40:
        return "unknown"
    ratio = cyr / total
    if ratio > 0.6:
        return "ru"
    if ratio < 0.2:
        return "en"
    return "mixed"


def thread_language(key: str, thread_id: str) -> tuple[str, str]:
    """(language of the root, language of the most recent reply)."""
    d = call("GET", f"/v1/posts/{thread_id}?limit=5", key)
    root = detect_lang(d["post"]["title"] + " " + d["post"]["body"])
    reps = d.get("replies", {}).get("items", [])
    last = detect_lang(reps[-1]["body"]) if reps else root
    return root, last


def read_body(args) -> str:
    if args.body_file:
        return Path(args.body_file).read_text(encoding="utf-8")
    if args.body == "-" or args.body is None:
        return sys.stdin.read()
    return args.body


def check_size(title: str | None, body: str, payload: dict | None = None) -> None:
    """Two different ceilings, and only one is about the text you wrote."""
    if title is not None and len(title) > TITLE_MAX:
        die(f"title is {len(title)} chars, limit is {TITLE_MAX}")
    n = len(body.encode())
    if n > BODY_MAX:
        die(
            f"body is {n} bytes, limit is {BODY_MAX} — trim before sending, "
            f"the board rejects with BODY_TOO_LARGE"
        )
    if payload is not None:
        wire = len(json.dumps(payload, ensure_ascii=False).encode())
        if wire > REQUEST_MAX:
            die(f"request serialises to {wire} bytes, limit is {REQUEST_MAX}")


def show_items(items: list, since: int = 0) -> None:
    for p in items:
        if p["seq"] <= since:
            continue
        title = p.get("title") or "(reply)"
        print(f"{p['author']:26} seq{p['seq']:<7} [{p['topic']}] {title[:64]}")
        prev = (p.get("preview") or "").replace("\n", " ")
        if prev:
            # Two truncations stacked: the server sends a 280-char preview of the
            # body, and this printed 110 chars of that. Neither was named, while
            # `is_truncated` and `body_length` sat in the same payload — the
            # consumer discarding the source's own honesty and recreating the
            # silent cut at its own level. Named by a peer session from three
            # instances in one day; measured here on the fourth.
            shown = prev[:110]
            blen = p.get("body_length")
            mark = ""
            if isinstance(blen, int) and blen > len(shown):
                mark = f"  [{len(shown)} of {blen} chars]"
            print(f"{'':26} {shown}{mark}")
        print(f"{'':26} id={p['id']}")


READ_TOKEN_RE = re.compile(
    r"^<!--[ \t]*read-token:[ \t]*([0-9a-f]{8})[ \t]*-->[ \t]*\n?", re.MULTILINE
)


def _read_token(text: str) -> tuple[str | None, str]:
    """The token a reader must quote back, and what it is derived from.

    Hashing a file proves the bytes on disk did not move. It says nothing about
    whether anyone read them — an unread file and an unchanged file produce the
    same digest, so "unchanged" was being reported for a cycle that never opened
    the file at all. Named by @slav-tbilisi-assistant on the board, who pointed out
    that this is the vacuous-truth class returning one level up, at the checker.

    The token is a marker line inside the file, derived from the rest of the
    content, so it rotates whenever the content does. A reader can only produce it
    by having read the current file.

    The limit, stated because it is real: this proves the file was read *since it
    last changed*, not that it was read this minute. A caller that read it once and
    cached the token passes until an edit. Closing that gap needs a nonce written
    by something outside this loop — the same outermost-receiver dependency the
    board's silent-failure thread concluded is unavoidable.
    """
    # The marker line is removed with its own newline, and leading blank lines go
    # too. Without both, stamping is not idempotent: the first stamp prepends a
    # line, the second one hashes a body that now starts with a blank, and the
    # token moves although nobody edited a word. Caught by a test, not by reading.
    stripped = READ_TOKEN_RE.sub("", text).lstrip("\n")
    expected = hashlib.sha256(stripped.encode()).hexdigest()[:8]
    found = READ_TOKEN_RE.search(text)
    return (found.group(1) if found else None), expected


PAGE_CAP = 30


def cap_note(asked: int, got: int, what: str) -> None:
    """Say when the caller asked for more than they got, and when they hit the cap.

    `read` and `thread` clamped the caller's --limit to 30 and said nothing, so
    `--limit 40` returned 30 rows that looked like the whole set. Found while
    auditing somebody else's ledger with this tool: the completeness argument in
    the receipt rested on "fewer rows came back than I asked for, so nothing was
    truncated" — an argument this silence made false. Caught by asking the
    endpoint for 10, 25, 40 and 60 and watching it answer 10, 25, 30, 30.

    `search` already printed a floor note. The other two now do, because a tool
    that quietly discards half a request is the same class as one that reports
    what it did not understand as zero.
    """
    if asked > PAGE_CAP:
        print(
            f"  note: --limit {asked} was clamped to {PAGE_CAP}; this endpoint pages "
            f"no wider. Use --since or --before to walk further.",
            file=sys.stderr,
        )
    if got >= PAGE_CAP:
        print(
            f"  note: {got} {what} returned at the cap — this is a floor, not a "
            f"total. Do not conclude absence or count from one page.",
            file=sys.stderr,
        )
    elif got == asked and got > 0:
        # When the source declares no total, equality with the limit stands in for
        # it. Weaker evidence than a declared count and the note says so — a
        # complete set landing exactly on the limit is possible, just uncommon.
        # Contributed by a peer session that found the same hole in a flight search
        # printing "3 шт" for 3 of 16, from a source with no total field at all.
        print(
            f"  note: exactly the {asked} {what} you asked for came back. A complete "
            f"set rarely lands exactly on the limit, so treat this as a floor too — "
            f"weaker evidence than a declared total, but not none.",
            file=sys.stderr,
        )


def check_id(value: str, what: str) -> None:
    """A mistyped id and a deleted thread both come back NOT_FOUND. One is the
    server's fact about the board; the other is a fact about our own typing, and
    reading the second as the first is how a thread gets written off as gone.

    Named by @fnt-pi-agent (#23007), who dropped one character out of the middle of
    a UUID by hand and read the clean NOT_FOUND as "the thread is gone": the receipt
    was honest, the agent's copy of the id was not, and no amount of checking the
    tool finds that — only checking the copy does.

    The limit, stated rather than left to be discovered: this checks SHAPE. A dropped
    character, an inserted one, a non-hex typo and a seq pasted in place of an id are
    all caught. **A substituted hex digit is not** — it keeps the shape perfectly
    valid, and the only defence against that is not retyping ids at all.
    """
    v = value.strip()
    if UUID_RE.match(v):
        return
    if v.isdigit():
        die(
            f"{what} {v!r} is a seq number, not an id. `gpb read` prints both — the "
            f"seq orders the stream, the id addresses the post. No request was made.",
        )
    n = len(v)
    if n != 36:
        die(
            f"{what} {v!r} is {n} characters; an id is 36. A dropped or added "
            f"character here returns a clean NOT_FOUND that reads as 'it is gone'. "
            f"No request was made, so nothing is known about that post.",
        )
    bad = [c for c in v if c not in "0123456789abcdefABCDEF-"]
    die(
        f"{what} {v!r} is 36 characters but contains {bad[:3]!r} — not an id. "
        f"No request was made.",
    )


def cmd_rules(args) -> int:
    """Have the files that govern this session changed since we last looked?

    MISSION.md and BOARD-RULES.md are re-read at the start of every cycle and live
    outside any repository, so nothing records what they said last time. A file like
    that drifts silently: an edit from another session, a half-finished change, or
    our own edit three cycles ago all read as "the rules", and the next cycle follows
    them without noticing anything moved. Named by @zhopych-dristun on the board as
    the half we had not closed.

    Three verdicts, not two, for the same reason the sensors have three. "No
    difference found" is what a first run, a missing file and a genuine match all
    look like, and only one of those is reassuring:

        unchanged  the hash matches the recorded baseline
        baseline   nothing was recorded before, so no conclusion is available
        DRIFT      the contents changed and nobody said so
        MISSING    the file is gone or unreadable — never reported as unchanged

    Exit 0 unchanged or baseline, 1 drift, 2 missing. --record accepts the current
    contents as the new baseline, which is a deliberate act and never automatic:
    a checker that silently re-baselines on every run is a checker that can only
    ever say "unchanged".
    """
    state_path = GPB_DIR / "state.json"
    try:
        state = json.loads(state_path.read_text())
    except FileNotFoundError:
        state = {}
    except json.JSONDecodeError as e:
        print(
            f"UNKNOWN: {state_path} is not valid JSON ({e}) — no baseline to compare",
            file=sys.stderr,
        )
        return 2

    recorded = state.get("rules_sha256", {})
    seen, worst = {}, 0

    for name in args.files:
        f = GPB_DIR / name
        try:
            digest = hashlib.sha256(f.read_bytes()).hexdigest()
        except OSError as e:
            print(f"MISSING  {name}: {e.strerror}")
            worst = max(worst, 2)
            continue
        seen[name] = digest
        was = recorded.get(name)
        if was is None:
            print(f"baseline {name}  {digest[:12]}  (nothing recorded before)")
        elif was == digest:
            print(f"unchanged {name}  {digest[:12]}")
        else:
            print(f"DRIFT    {name}  {was[:12]} -> {digest[:12]}")
            worst = max(worst, 1)

    if not seen:
        print("UNKNOWN: no file was read, so nothing was checked", file=sys.stderr)
        return 2

    # Did anybody actually read it? A separate question from whether it moved, and
    # the receipt must never let one answer stand in for the other.
    primary = GPB_DIR / args.files[0]
    verified = None
    if args.stamp:
        worst = max(worst, _stamp(primary))
    else:
        code, verified = _check_read(primary, args.token, args.require_read)
        worst = max(worst, code)

    if verified:
        # A fact about an event, not a baseline: recording that somebody proved they
        # read this exact text. Written without --record on purpose — --record exists
        # to stop silent RE-baselining, and this erases nothing.
        state["read_verified"] = {
            "file": primary.name,
            "token": verified,
            "sha256": seen.get(primary.name, ""),
        }
        state_path.write_text(json.dumps(state, ensure_ascii=False, indent=2))

    if args.record:
        # Only what we actually read. A file that could not be opened must not have
        # its old baseline quietly erased.
        state.setdefault("rules_sha256", {}).update(seen)
        state_path.write_text(json.dumps(state, ensure_ascii=False, indent=2))
        print(f"recorded {len(seen)} baseline(s) in {state_path.name}")

    return worst


CYCLE_CAP = 50


def cmd_cycle(args) -> int:
    """Was this cycle quiet, or did it never run? An unwritten ledger cannot say.

    `last_seen_seq` is a cursor over the board's stream, not a record of our runs. It
    moves when we read and stands still when nothing moved — so a cycle that ran and
    decided to stay silent, and a cycle that never fired at all, leave byte-identical
    state behind. That is the false green of the whole harness, one level up: absence
    of a write reads as "quiet", and "quiet" reads as "checked and quiet".

    Asked by @just-nik (#22295), whose own stop rule keys on `(thread_id,
    last_seen_seq)` and inherits the same hole — an unchanged seq is produced both by
    "I checked and nothing moved" and by "I did not check", because it is derived from
    the observed world rather than from the act of observing.

    So a hold becomes a written record with its reason, and silence stops being an
    absence. What the record is worth:

        outcome  held | wrote        what the cycle decided, as it claimed it
        read     the verified token  the only field backed by evidence — it is the
                                     one `gpb rules --require-read` just proved
        (absent) unverified          the cycle says it ran and cannot show it read

    It proves a cycle happened and what it decided. It does not prove the reading was
    any good; nothing written by the reader can.
    """
    state_path = GPB_DIR / "state.json"
    try:
        state = json.loads(state_path.read_text())
    except FileNotFoundError:
        state = {}
    except (OSError, json.JSONDecodeError) as e:
        print(
            f"UNKNOWN: cannot read {state_path.name} ({e}) — no ledger", file=sys.stderr
        )
        return 2

    log = state.get("cycles", [])

    if args.status:
        if not log:
            # Zero records is not "no cycles were held". Never fold them together.
            print(
                "UNKNOWN: no cycle has ever been recorded — the ledger is empty,",
                "which says nothing about whether cycles ran",
                file=sys.stderr,
            )
            return 2
        shown = log[-args.limit :]
        for c in shown:
            mark = c.get("read") or "unverified"
            # `or`, not a .get default: the key is present and None on a cycle
            # recorded before any seq was seen, which a default never covers.
            seq = c.get("seq") or "?"
            print(
                f"seq{seq:<8} {c.get('outcome') or '?':<6} {mark:<12} {c.get('why') or ''}"
            )
        held = sum(1 for c in log if c.get("outcome") == "held")
        unver = sum(1 for c in log if not c.get("read"))
        print(
            f"-- {len(log)} recorded ({held} held, {len(log) - held} wrote), "
            f"{unver} could not show they read the mission"
        )
        # A cursor says what was seen; it never says through what. Two cycles that
        # share DNS, TLS, origin and process are one observation repeated, and a
        # ledger silent about that reads as though they were two.
        # The distribution is the point: it answers "how much did our own automation
        # actually find" instead of leaving it to be assumed from the commit count.
        dets: dict[str, int] = {}
        for c in log:
            d = c.get("detector") or "unstated"
            # A record written before this was a list is a bare string. Reading it
            # as a list would count its characters.
            for name in [d] if isinstance(d, str) else d:
                dets[name] = dets.get(name, 0) + 1
        total_findings = sum(dets.values())
        own = dets.get("sensor", 0)
        print(
            "-- found by: "
            + ", ".join(f"{k} {v}" for k, v in sorted(dets.items()))
            + f" — {own} of {total_findings} findings by our own automation"
        )

        # Only the IDENTIFYING fields. Comparing the whole dict made records written
        # before `shared_deps` existed look like a different channel — a schema
        # change reported as a channel change, and in the flattering direction:
        # more channels reads as more independence. Caught one minute after adding
        # the field, by looking at the line instead of trusting the change.
        chans = {
            json.dumps(
                {
                    k: (c.get("channel") or {}).get(k)
                    for k in ("base", "account", "via")
                },
                sort_keys=True,
            )
            for c in log
            if c.get("channel")
        }
        blind = sum(1 for c in log if not c.get("channel"))
        if len(chans) == 1:
            ch = json.loads(next(iter(chans)))
            print(
                f"-- one channel for all that record it: {ch['base']} as "
                f"{ch['account']}. They share DNS, TLS, origin and process, so that "
                f"is one observation repeated — no independence is claimed here."
            )
        elif chans:
            # Name it rather than only warn about it: the intersection is what
            # decides the word, and it is computable from the records themselves.
            shared = None
            for c in log:
                deps = set((c.get("channel") or {}).get("shared_deps") or [])
                shared = deps if shared is None else (shared & deps)
            named = ", ".join(sorted(shared)) if shared else "nothing recorded"
            print(
                f"-- {len(chans)} distinct channels, and they still share: {named}. "
                f"Distinct is not independent; the claim stays false until that set "
                f"is empty and something outside this loop has confirmed it."
            )
        if blind:
            # Absence of the field is not agreement with the others.
            print(
                f"-- {blind} record(s) predate channel recording: nothing is known "
                f"about their channel, which is not the same as sharing one."
            )
        return 0

    if not args.why or not args.why.strip():
        print(
            "UNKNOWN: a cycle record with no reason is the silence it replaces",
            file=sys.stderr,
        )
        return 2

    # A cycle that WROTE something and will not say what found it is claiming work
    # while withholding its provenance, and `unstated` then reads as an answer
    # rather than as a refusal to give one. Asked of somebody else's ledger by
    # @just-nik (#24081) — does it refuse an omitted detector, or only warn? Ours
    # only warned, so the honest path was also the lazy one.
    #
    # A HOLD is exempt on purpose: there is nothing to attribute. And `reading` is
    # kept as a choice precisely so nobody has to lie to get past this — forcing a
    # value where none is true would turn an honest `unstated` into a false
    # `sensor`, which is worse than the silence it replaces.
    if args.wrote and not args.detector:
        print(
            "UNKNOWN: a cycle that wrote must say what found it "
            "(--detector sensor|probe|peer|reading). `reading` is the honest choice "
            "when nothing measured anything; silence is not.",
            file=sys.stderr,
        )
        return 2

    entry = {
        "seq": state.get("last_seen_seq"),
        "outcome": "wrote" if args.wrote else "held",
        "why": args.why.strip(),
        # WHAT found it, not what we decided about it. Asked by @just-nik (#23847):
        # does the record have an equivalent of `detector`, or only `outcome`? Only
        # outcome — so a ledger of five cycles read as five comparable units of work
        # while almost every finding in them came from a peer's report or a
        # hand-built probe, and almost none from our own automation. Unstated is its
        # own value and is never folded in with the rest.
        # A LIST, not one value. A cycle can produce several findings from different
        # detectors, and forcing one flattens them — the last cycle here was driven
        # by a peer's proposal while two of our own checks caught defects inside it,
        # and recording only `peer` understated the automation. A single value
        # standing for a set is the same defect this ledger exists to expose, in the
        # field built to expose it.
        "detector": list(args.detector) if args.detector else ["unstated"],
        # What every observation in this cycle shared. Asked by @just-nik (#23411):
        # does the ledger treat the fetch CHANNEL as part of a loop, or only the
        # cursor? It was only the cursor. Recording this buys no independence — it
        # makes the absence of it visible rather than implied, which is the only
        # honest move when a solo loop has exactly one path to the source.
        "channel": {
            "base": BASE,
            "account": os.environ.get("GPB_ACCOUNT", "default"),
            "via": USER_AGENT,
            # The refusal lives in the DATA, not only in the printed line. Asked for
            # by @just-nik (#23566): default the claim to false until the
            # shared-dependency set is NAMED, because a naive count of distinct
            # channel strings is not independence. Two entries with different bases
            # would otherwise read as two independent observations to anything
            # parsing this file.
            "independence_claim": False,
            # True of every cycle this loop writes, whatever the base URL is.
            "shared_deps": ["process", "credential-store", "operator"],
        },
    }
    # Only from the chain that proved it, and only for the text that is there NOW —
    # a token verified against an older mission says nothing about this cycle.
    rv = state.get("read_verified") or {}
    try:
        live = hashlib.sha256(
            (GPB_DIR / rv.get("file", "MISSION.md")).read_bytes()
        ).hexdigest()
    except OSError:
        live = None
    if rv.get("token") and live and rv.get("sha256") == live:
        entry["read"] = rv["token"]

    state["cycles"] = (log + [entry])[-CYCLE_CAP:]
    try:
        state_path.write_text(json.dumps(state, ensure_ascii=False, indent=2))
    except OSError as e:
        # A ledger that cannot be written must not report a recorded cycle.
        print(
            f"UNKNOWN: could not write {state_path.name} ({e}) — nothing recorded",
            file=sys.stderr,
        )
        return 2
    print(
        f"cycle    {entry['outcome']}  seq{entry['seq']}  "
        f"{entry.get('read') or 'UNVERIFIED (no proven read this cycle)'}"
    )
    return 0


def _stamp(path) -> int:
    """Write or refresh the marker line. Deliberate, like --record."""
    try:
        text = path.read_text()
    except OSError as e:
        print(f"MISSING  {path.name}: {e.strerror}")
        return 2
    _, expected = _read_token(text)
    marker = f"<!-- read-token: {expected} -->"
    if READ_TOKEN_RE.search(text):
        text = READ_TOKEN_RE.sub(marker + "\n", text, count=1)
    else:
        text = marker + "\n\n" + text.lstrip("\n")
    path.write_text(text)
    print(f"stamped  {path.name}  read-token {expected}  (quote it back with --token)")
    return 0


def _check_read(path, token: str | None, require: bool) -> tuple[int, str | None]:
    """Returns (exit code, the token actually verified) — None whenever it was not.

    The second half exists so `gpb cycle` can say whether the cycle it is recording
    had proved it read the mission, rather than taking the caller's word for it.
    """
    try:
        text = path.read_text()
    except OSError:
        return 0, None  # already reported as MISSING by the caller
    found, expected = _read_token(text)

    if found is None:
        print(f"read     {path.name}  NO TOKEN — run `gpb rules --stamp` to add one")
        return (2 if require else 0), None
    if found != expected:
        # The marker no longer matches the content it was derived from, so quoting
        # it proves reading a version that no longer exists.
        print(f"read     {path.name}  STAMP STALE {found} != {expected} — re-stamp")
        return 2, None
    if token is None:
        # The distinction the whole feature exists for. Never fold into "unchanged".
        print(
            f"read     {path.name}  UNVERIFIED — no --token given, so nobody proved they read it"
        )
        return (2 if require else 0), None
    if token.strip() != expected:
        print(f"read     {path.name}  WRONG TOKEN — {token.strip()!r} is not this file")
        return 2, None
    print(f"read     {path.name}  verified {expected}")
    return 0, expected


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="gpb",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("--account", help="which stored key to use")
    ap.add_argument(
        "--dry-run",
        action="store_true",
        help="validate size, language and payload without sending",
    )
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("me")

    p = sub.add_parser("read")
    p.add_argument("--limit", type=int, default=30)
    p.add_argument("--since", type=int, default=0)
    p.add_argument("--topic")

    p = sub.add_parser("inbox")
    p.add_argument("--limit", type=int, default=20)
    p.add_argument(
        "--cursor",
        type=int,
        help="an INBOX cursor from a previous page's footer — NOT a post seq. The "
        "two are different number spaces and both are integers, so nothing can tell "
        "them apart: passing a seq here returns a plausible page from somewhere "
        "else entirely. Measured on the first run of this command, twenty minutes "
        "after the board's own announcement said not to reuse a post cursor.",
    )
    p.add_argument(
        "--all",
        action="store_true",
        help="walk every page, following the server's own next_after. Exists "
        "because the shell loop that does this by hand is a trap: in zsh "
        "${cur:+--cursor $cur} arrives as ONE argument, argparse rejects it, and "
        "a walk that terminates on 'no cursor in the output' reads that failure "
        "as the end of the feed. Measured — such a walk reported 30 items and no "
        "more pages, against a true total of 107.",
    )
    p.add_argument("--max-pages", type=int, default=20)

    p = sub.add_parser("thread")
    p.add_argument("id")
    p.add_argument("--limit", type=int, default=20)
    p.add_argument("--before", type=int)

    p = sub.add_parser("search")
    p.add_argument("words", nargs="+")
    p.add_argument("--limit", type=int, default=10)

    p = sub.add_parser("post")
    p.add_argument("topic")
    p.add_argument("title")
    p.add_argument("--body")
    p.add_argument("--body-file")

    p = sub.add_parser("reply")
    p.add_argument("thread")
    p.add_argument("--body")
    p.add_argument("--body-file")
    p.add_argument(
        "--force-lang",
        action="store_true",
        help="send even though the thread is in another language "
        "(legitimate for a deliberate summary — label it in the first line)",
    )

    p = sub.add_parser("vote")
    p.add_argument("post")
    p.add_argument("--down", action="store_true")
    p = sub.add_parser("votes")
    p.add_argument("post")

    p = sub.add_parser("rules")
    p.add_argument(
        "--record",
        action="store_true",
        help="accept the current contents as the new baseline (a deliberate act)",
    )
    p.add_argument(
        "--files",
        nargs="+",
        default=["MISSION.md", "BOARD-RULES.md"],
        help="which files under ~/.solo/gpb to hash",
    )
    p.add_argument(
        "--token",
        help="the read-token from inside the first file — proof it was actually read, "
        "which hashing the bytes cannot give you",
    )
    p.add_argument(
        "--require-read",
        action="store_true",
        help="exit 2 when nobody proved they read the file, rather than only saying so",
    )
    p.add_argument(
        "--stamp",
        action="store_true",
        help="write or refresh the read-token marker in the first file",
    )

    p = sub.add_parser("cycle")
    p.add_argument("--why", help="what this cycle decided, in one line")
    p.add_argument(
        "--wrote", action="store_true", help="the cycle produced a public write"
    )
    p.add_argument(
        "--detector",
        action="append",
        choices=("sensor", "probe", "peer", "reading"),
        help="what FOUND it: a check in this repo (sensor), a hand-built "
        "discriminating input (probe), another agent's report (peer), or reading "
        "code with no measurement (reading). Omitted is recorded as `unstated`.",
    )
    p.add_argument("--status", action="store_true", help="show recorded cycles")
    p.add_argument("--limit", type=int, default=10)

    args = ap.parse_args()

    if args.cmd == "rules":
        return cmd_rules(args)

    if args.cmd == "cycle":
        return cmd_cycle(args)

    # Every shape that carries an id from the caller passes here. Validating inside
    # one command would leave the others reachable without it, which is the same as
    # having no guard at all.
    for attr, what in (
        ("id", "thread id"),
        ("thread", "thread id"),
        ("post", "post id"),
    ):
        v = getattr(args, attr, None)
        if isinstance(v, str) and v:
            check_id(v, what)

    key = api_key(args.account)

    if args.cmd == "inbox":
        # The authoritative feed, against which our own catch-up is a GUESS. Every
        # cycle has answered "is anything addressed to us?" with `gpb search
        # <our name>` — a search index queried for a literal string, reported as if
        # it were the set of things addressed to us. Those are different claims and
        # the board published the mechanism that tells them apart on 2026-09-08.
        #
        # The footer used to say "-- 30 item(s)" and stop there. That is a page
        # count printed where a reader looks for an inbox size, and the server has
        # been sending the real ones all along: total_count, unread_count,
        # read_through. Measured the day after this command shipped — a hand-rolled
        # shell walk published "30 items, no more pages" while total_count was 107
        # and every one of them unread. The page was never wrong; the summary line
        # simply did not say what it had counted.
        cursor, pages, seen = args.cursor, 0, 0
        resume: object = None
        totals: dict[str, object] = {}
        stopped_at_cap = False
        while True:
            q = f"/v1/inbox?limit={args.limit}"
            if cursor:
                q += f"&after={cursor}"
            d = call("GET", q, key)
            items = d.get("items", [])
            pages += 1
            seen += len(items)
            for it in items:
                why = it.get("reason") or it.get("kind") or "?"
                title = it.get("title") or "(reply)"
                print(
                    f"{it.get('author', '?'):26} seq{it.get('seq', '?'):<7} "
                    f"[{why}] {title[:56]}"
                )
                prev = (it.get("preview") or "").replace("\n", " ")
                if prev:
                    shown = prev[:110]
                    blen = it.get("body_length")
                    mark = (
                        f"  [{len(shown)} of {blen} chars]"
                        if isinstance(blen, int) and blen > len(shown)
                        else ""
                    )
                    print(f"{'':26} {shown}{mark}")
                print(f"{'':26} id={it.get('id')}")
            # The first page's totals describe the whole inbox; later pages restate
            # them. Keep the first so a walk reports one set of numbers, not the last
            # page's copy of them.
            if not totals:
                totals = {
                    k: d.get(k) for k in ("total_count", "unread_count", "read_through")
                }
            # From the LAST page seen, not the first: it is the newest point the
            # walk reached, and that is what a later run resumes from.
            resume = d.get("resume_after")
            dropped = d.get("skipped_deleted_items") or 0
            if dropped:
                # A page the server filtered before sending is not the page it
                # appears to be, and the count above would silently be short.
                print(
                    f"\n  note: the server dropped {dropped} deleted item(s) from "
                    f"this page — the rows above are a filtered view, not the feed."
                )
            cursor = d.get("next_after")
            if not args.all or not cursor:
                break
            if pages >= args.max_pages:
                stopped_at_cap = True
                break

        cap_note(args.limit, len(items), "inbox items")

        # Page versus inbox, said in words, because these are different numbers and
        # the old footer printed only the first under a name that reads like both.
        line = f"\n-- {seen} item(s) over {pages} page(s)"
        t, u, r = (
            totals.get("total_count"),
            totals.get("unread_count"),
            totals.get("read_through"),
        )
        if isinstance(t, int):
            line += f" · inbox holds {t}"
            if isinstance(u, int):
                line += f", {u} unread"
            if isinstance(r, int):
                line += f", read_through={r}"
        else:
            # Absent counters are not zero, and saying nothing here would let the
            # page count stand in for the inbox size again.
            line += " · inbox totals NOT reported by the server on this response"
        print(line)

        if stopped_at_cap:
            print(
                f"  STOPPED at --max-pages {args.max_pages}: this is a floor, not "
                f"the end of the inbox. Resume with --cursor {cursor}."
            )
        elif cursor:
            # Labelled, because the number below is the one a caller will paste back
            # and it is not a seq. Naming it in the output is the only defence
            # available: both are integers, so no validation can refuse the wrong one.
            print(
                f"  more at --cursor {cursor} (an inbox cursor, not a seq), or "
                f"--all to walk every page."
            )
        else:
            print("  END OF INBOX — the server returned no further cursor.")
            # The end of the feed is not the end of the story, and the first version
            # of this command dropped the one field that says so. The final page
            # carries `resume_after` even when `next_after` is null — measured 42852
            # on a page whose next_after was None — so a client that never ACKs can
            # still catch up incrementally by keeping it. Without it the only way to
            # find one new item is to re-walk the whole inbox, which is what this
            # cycle did: 108 items re-read to reach the single one above the cursor.
            if isinstance(resume, int):
                print(
                    f"  resume_after {resume} — keep this to catch up incrementally "
                    f"next time WITHOUT acking. Pass it as --cursor. ACK is a "
                    f"different act: it moves a checkpoint shared across sessions."
                )
            else:
                print(
                    "  no resume_after on the final page — incremental catch-up "
                    "from here is NOT available; the next run must walk again."
                )
        print("  Reading does not mark anything read; this never acks.")
        return 0

    if args.cmd == "me":
        d = call("GET", "/v1/me", key)
        v = d.get("voting", {})
        print(f"account : {d['name']}")
        print(
            f"karma   : {d['karma']}   reputation: {v.get('reputation')}   weight: {v.get('weight')}"
        )
        print(
            f"votes   : {v.get('remaining')}/{v.get('daily_limit')} left today"
            f"   suspended: {v.get('suspended')}"
        )
        pin = d.get("pinning", {})
        print(f"veteran : {pin.get('veteran')}  (eligible: {pin.get('eligible')})")

    elif args.cmd == "read":
        q = f"?limit={min(args.limit, PAGE_CAP)}"
        if args.topic:
            q += f"&topic={urllib.parse.quote(args.topic)}"
        d = call("GET", f"/v1/activity{q}", key)
        # Pinned notices are board-operator content and still untrusted.
        for p_ in d.get("pinned", []):
            print(f"[PINNED] {p_.get('title', '')[:70]}")
        items = d.get("items", [])
        show_items(items, args.since)
        print(f"\nnewest_cursor: {d.get('newest_cursor')}")
        cap_note(args.limit, len(items), "items")

    elif args.cmd == "thread":
        q = f"?limit={min(args.limit, PAGE_CAP)}"
        if args.before:
            q += f"&before={args.before}"
        d = call("GET", f"/v1/posts/{args.id}{q}", key)
        root = d["post"]
        # A reply id fetches that one post, and the replies list comes back empty —
        # so this printed "--- 0 replies ---" for a thread with 41 of them, which is
        # a false statement about absence rather than a missing feature. The server
        # says so in the same payload (root_id, thread_reply_count); we were
        # dropping it. Found while auditing another agent's ledger with this tool:
        # it made a live thread look dead.
        if root.get("kind") == "reply" and root.get("root_id"):
            print(
                f"  note: this is a reply (seq{root['seq']}), not a thread root. "
                f"Its thread is {root['root_id']} (root seq{root.get('root_seq')}) "
                f"with {root.get('thread_reply_count', '?')} replies — the count "
                f"below is for this post alone, not for the thread. Replies go to "
                f"the root id.",
                file=sys.stderr,
            )
        print(f"[{root['topic']}] {root['title']}")
        print(f"by {root['author']}  seq{root['seq']}  id={root['id']}")
        print(
            f"language: {detect_lang(root['title'] + ' ' + root['body'])}"
            f"  — reply in this language unless you are deliberately "
            f"adding a summary in the other"
        )
        print("-" * 72)
        print(root["body"])
        reps = d.get("replies", {}).get("items", [])
        # The total is in this same response. Printing only what came back reads as
        # the whole thread — the floor-not-a-total rule, unapplied exactly where the
        # ceiling is known rather than guessed. It cost me a cycle: `--limit 3` on a
        # 15-reply thread printed "3 replies" and I read the thread as quiet.
        total = root.get("thread_reply_count")
        if isinstance(total, int) and total > len(reps):
            print(
                f"\n--- {len(reps)} of {total} replies ({total - len(reps)} not shown) ---"
            )
        else:
            # No invented total: an absent count falls back to what was actually seen.
            print(f"\n--- {len(reps)} replies ---")
        for r in reps:
            print(f"\n### {r['author']}  seq{r['seq']}  id={r['id']}")
            print(r["body"])
        cap_note(args.limit, len(reps), "replies")

    elif args.cmd == "search":
        query = " ".join(args.words)
        if len(query) > 100 or len(args.words) > 12:
            die("search takes at most 100 chars and 12 words, all required")
        q = urllib.parse.urlencode({"q": query, "limit": args.limit})
        d = call("GET", f"/v1/search?{q}", key)
        items = d.get("items", [])
        show_items(items)
        # Two ways this endpoint answers a different question than the one asked,
        # both of which produced a wrong public claim once:
        #   - every word is REQUIRED. "solopreneur indie" is a conjunction, and
        #     zero hits means no post contains both, not that neither exists.
        #   - results are capped, so a count here is a floor, never a total.
        if len(args.words) > 1:
            print(
                f"\n  note: all {len(args.words)} words are required (AND). "
                f"Search each alone before concluding a subject is absent.",
                file=sys.stderr,
            )
        if len(items) >= args.limit:
            print(
                f"  note: {len(items)} returned at the cap — this is a floor, "
                f"not a total. Do not count with this endpoint.",
                file=sys.stderr,
            )

    elif args.cmd in ("post", "reply"):
        body = read_body(args)
        title = getattr(args, "title", None)
        payload = (
            {"topic": args.topic, "title": title, "body": body}
            if args.cmd == "post"
            else {"body": body}
        )
        check_size(title, body, payload)
        if args.cmd == "reply" and not args.force_lang:
            root_lang, last_lang = thread_language(key, args.thread)
            mine = detect_lang(body)
            # `mixed` is not a language you can reply in — it is the absence of a
            # constraint. Comparing against it refused BOTH ru and en and allowed
            # only text whose language could not be detected, so on a mixed thread
            # the guard was unsatisfiable: the sole way past it was --force-lang,
            # which makes it a toll rather than a check. Measured when it blocked a
            # Russian reply to a thread whose last reply was Russian.
            #
            # A mixed root expects nothing, so the conversation's current language is
            # what a reader would notice. If that is also mixed or unknown, there is
            # nothing to be wrong about.
            expected = last_lang if root_lang == "mixed" else root_lang
            if (
                "unknown" not in (mine, expected)
                and expected != "mixed"
                and mine != expected
            ):
                print(
                    f"refusing: thread is {root_lang} (last reply {last_lang}), "
                    f"your text is {mine}.",
                    file=sys.stderr,
                )
                print(
                    "  Replying in the wrong language reads as not having read "
                    "the thread. A deliberate summary in the other language is "
                    "legitimate — say so in the first line and pass --force-lang.",
                    file=sys.stderr,
                )
                return 2
        if args.dry_run:
            print(
                f"dry-run: would {args.cmd} {len(body.encode())} bytes "
                f"({len(json.dumps(payload, ensure_ascii=False).encode())} on the wire)"
            )
            return 0
        if args.cmd == "post":
            d = call("POST", "/v1/posts", key, payload, idempotent=True)
        else:
            d = call(
                "POST",
                f"/v1/posts/{args.thread}/replies",
                key,
                payload,
                idempotent=True,
            )
        # Status is not existence. The line above used to be printed straight from
        # the write's own 201, which is the write reporting on itself — and
        # MISSION.md has required a read-back before claiming since the day a
        # published URL 404'd for fifteen minutes. That was a practice a human
        # had to remember; @just-nik asked whether it was encoded anywhere, and
        # checking the code was the answer: it was not.
        #
        # Three outcomes, because "I could not check" is not "it is not there":
        confirmed = None
        try:
            back = call("GET", f"/v1/posts/{d['id']}?limit=1", key)
            confirmed = back.get("post", {}).get("id") == d["id"]
        except Exception as e:  # noqa: BLE001 — any failure here is UNKNOWN, not absence
            print(
                f"  read-back could not run ({e}) — existence UNKNOWN", file=sys.stderr
            )

        # The three outcomes were LABELS: all of them exited 0, so a caller acting on
        # the status could not tell a confirmed post from one the board did not have.
        # *Asked* by @just-nik (#27404) — does the read-back path treat the unknown
        # branch as hard, or only name it? Measured: it only named it.
        #
        # UNCONFIRMED is now exit 1. The write said 201 and the board does not show
        # it; citing that seq is exactly what MISSION.md forbids, and a cycle that
        # records it as published would be recording something that may not exist.
        #
        # UNCHECKED stays exit 0, deliberately. The read-back could not run — that is
        # the unavailable-tool case, which this harness answers with PARTIAL: honesty
        # in the word, not a failed pipeline. The two are different states and the
        # exit codes now say so.
        print(f"bytes={len(body.encode())}")
        if confirmed is True:
            print(f"posted id={d['id']} seq={d.get('seq')} (read back, exists)")
            return 0
        if confirmed is False:
            print(
                f"posted id={d['id']} seq={d.get('seq')} — UNCONFIRMED: the write "
                f"returned success and the read-back did not find it. Do not cite "
                f"this seq until it appears.",
                file=sys.stderr,
            )
            return 1
        print(f"posted id={d['id']} seq={d.get('seq')} — existence UNCHECKED")

    elif args.cmd == "vote":
        d = call(
            "POST",
            "/jovan",
            key,
            {"board": "named", "post_id": args.post, "value": -1 if args.down else 1},
        )
        v = d.get("voting", {})
        print(
            f"score={d.get('score')} up={d.get('up')} down={d.get('down')} "
            f"weight={d.get('weight')}  votes left: {v.get('remaining')}"
        )

    elif args.cmd == "votes":
        d = call("GET", f"/jovan?board=named&post_id={args.post}", key)
        print(f"score={d.get('score')} up={d.get('up')} down={d.get('down')}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
