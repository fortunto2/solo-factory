#!/usr/bin/env python3
"""Which tests never fail? Break the code and find out.

Every cycle this week ended with the same manual ritual: change one line so the
behaviour is wrong, run the tests, count how many go red, put the line back,
check the file hash. It caught real things a checker could not — tests that
matched a filename instead of a diagnostic, tests that branched on the answer
they were meant to assert, a control that ran on an input where it could not
fire. None of those look wrong when you read them.

So it is a command now. It is deliberately narrow: one file, its own test file,
one mutation at a time.

Three rules taken from this harness's own contract, because a mutation run has
the same failure modes as any other probe:

  the baseline must be green first  — a mutant proves nothing against a red suite
  "applied" is a fact about the file — sha256 before and after, never an exit code
  "restored" is the same fact       — the hash must come back identical

A surviving mutant is not proof a test is worthless; it is a question. Sometimes
the mutation is behaviour nobody promised. The output says which tests ran, so
the answer stays with the reader.

    scripts/mutate scripts/check-shippable tests/shippable.bats
    scripts/mutate --list scripts/check-shippable
"""

from __future__ import annotations

import ast
import hashlib
import os
import re
import signal
import subprocess
import sys
from pathlib import Path

# Small, meaning-changing edits. Each is (name, pattern, replacement) applied to
# one occurrence at a time. They are chosen to break behaviour rather than syntax:
# a mutant that does not run teaches nothing.
# The trailing-comment group is not cosmetic. The first version anchored on `:$`,
# so every `if ...:  # note` in a codebase was silently unmutatable — and an
# operator that cannot reach a construct reports zero survivors there, which
# reads as coverage. Found by pointing the tool at a changed line that happened
# to carry a comment and getting "0 of 0".
MUTATIONS: list[tuple[str, str, str]] = [
    (
        "condition always true",
        r"^(\s*)if (?!True\b|False\b)([^:\n]+):(\s*#.*)?$",
        r"\1if True:  # mutant",
    ),
    (
        "condition always false",
        r"^(\s*)if (?!True\b|False\b)([^:\n]+):(\s*#.*)?$",
        r"\1if False:  # mutant",
    ),
    ("comparison flipped", r"([^<>=!])==([^=])", r"\1!=\2"),
    ("boundary moved", r"([^<>=!])>=([^=])", r"\1>\2"),
    ("early return", r"^(\s+)(return \w+.*)$", r"\1return None  # mutant"),
]


def sha(p: Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


def run_tests(test_file: Path) -> tuple[int, str]:
    r = subprocess.run(["bats", str(test_file)], capture_output=True, text=True)
    return r.returncode, r.stdout


# Mutations that cannot change observable behaviour, so a survivor says nothing
# about the tests. Measured on the first real run: 3 of 5 survivors were these,
# a 60% noise rate, and a checker at that rate gets ignored within a week.
#
#   __name__ guard   flipping it changes nothing when the module is imported,
#                    and nothing when it is run either
#   return 0 -> None sys.exit(None) and sys.exit(0) are the same exit status,
#                    so the mutant is equivalent rather than surviving
EQUIVALENT = (
    re.compile(r"__name__\s*==\s*.__main__."),
    re.compile(r"^\s*return (0|None)\s*$"),
)


def data_lines(text: str) -> set[int]:
    """Lines belonging to a module-level literal table: data, not behaviour.

    Pointed at itself, this tool spent most of its mutants rewriting its own
    MUTATIONS and EQUIVALENT tables — changing which mutations exist rather than
    what the code does. Those survive every test and mean nothing, and they were
    the majority of the first self-run's 23 survivors.

    The general form, not a special case for this file: a module-level assignment
    to a list, tuple, set or dict literal is configuration. Mutating a `==` inside
    one produces a different configuration, not a defect, so no test should be
    expected to catch it.
    """
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return set()
    lines: set[int] = set()
    for node in tree.body:
        if not isinstance(node, (ast.Assign, ast.AnnAssign)):
            continue
        value = node.value
        if isinstance(value, (ast.List, ast.Tuple, ast.Set, ast.Dict)):
            end = getattr(node, "end_lineno", node.lineno)
            lines.update(range(node.lineno, end + 1))
    return lines


def changed_lines(target: Path) -> set[int] | None:
    """Lines this working tree changed against HEAD, or None if it cannot tell.

    A whole-file run is unusable where it matters most: solo-verify offers 261
    candidates at 33s per test run — two and a half hours, so it never gets run,
    and a tool nobody runs measures nothing. This repo's own contract already
    says the workable use is the narrow one, mutants for the code a change
    actually touched.

    None, not an empty set, when git cannot answer: an empty set would silently
    mutate nothing and report a clean sweep, which is the absent-baseline false
    green in one more place.
    """
    # Absolute path, and cwd is the file's directory so git finds the repository.
    # The first draft passed a repo-relative path while running from scripts/, so
    # git looked for scripts/scripts/mutate, found nothing, and reported no
    # changes — a scoping bug that would have quietly mutated nothing and called
    # it clean.
    r = subprocess.run(
        ["git", "diff", "-U0", "HEAD", "--", str(target.resolve())],
        capture_output=True,
        text=True,
        cwd=target.resolve().parent,
        # An inherited GIT_DIR overrides cwd, so --changed would take its hunks from
        # another repository and mutate lines this file never had.
        env={
            k: v
            for k, v in os.environ.items()
            if k not in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE")
        },
    )
    if r.returncode != 0:
        return None
    lines: set[int] = set()
    for hunk in re.finditer(r"^@@ -\S+ \+(\d+)(?:,(\d+))? @@", r.stdout, re.MULTILINE):
        start = int(hunk.group(1))
        count = int(hunk.group(2) or 1)
        lines.update(range(start, start + count))
    return lines


def candidates(text: str, only: set[int] | None = None) -> list[tuple[str, str, str]]:
    """Every (name, before, after) this file admits, one occurrence each."""
    out = []
    skip = data_lines(text)
    for name, pat, rep in MUTATIONS:
        rx = re.compile(pat, re.MULTILINE)
        for m in rx.finditer(text):
            before = m.group(0)
            after = rx.sub(rep, before, count=1) if rx.match(before) else None
            if after is None or after == before:
                # Re-apply against the whole line so anchored patterns still work.
                after = text[m.start() : m.end()]
                after = rx.sub(rep, after, count=1)
            line = text[: m.start()].count("\n") + 1
            if (
                after != before
                and line not in skip
                and (only is None or line in only)
                and not any(e.search(before) for e in EQUIVALENT)
            ):
                out.append((name, before, after))
    return out


def one_sided(outcomes: list[tuple[int, str, bool, str]]) -> list[str]:
    """Conditions where one direction is caught and the mirror direction is not.

    Two independent survivors read as two test gaps. Both directions of the SAME
    condition, with exactly one killed, is a sharper and different thing: the tests
    pin one side of a boundary, so a repair that overshoots to the other side passes
    every one of them. Adding a further iteration cannot be caught by that suite —
    only stepping back can.

    Named by a peer session from its own case: a substring match on `to` inside
    `Director` was repaired with `\\b`, and `\\bpassport\\b` then failed to match
    `passport_issue`, because an underscore is a word character. Both versions wrong
    in opposite directions, each passing the test written for the other. The class is
    not "a regex without boundaries" but **a repair that looks like a repair**.

    Reported by them, measured here: this repository has no `\\b` in any regex, so the
    specific instance is absent and the shape is not.
    """
    by_line: dict[int, dict[str, bool]] = {}
    text: dict[int, str] = {}
    for line, name, was_killed, src in outcomes:
        if name.startswith("condition always "):
            by_line.setdefault(line, {})[name] = was_killed
            text[line] = src
    out = []
    for line, seen in sorted(by_line.items()):
        # Both directions must have RUN. One direction alone says nothing about
        # asymmetry — it says the other mutation never applied.
        if len(seen) == 2 and sum(seen.values()) == 1:
            caught = next(n for n, k in seen.items() if k)
            missed = next(n for n, k in seen.items() if not k)
            out.append(
                f"line {line}: {caught} is caught, {missed} is not — {text[line]}"
            )
    return out


CRUMB_V = "solo-mutate-crumb v1"


def write_crumb(crumb: Path, target: Path, original: str) -> None:
    """Write the crumb atomically: temp, fsync, rename. Never truncate in place.

    *Named* by @kolpaq (#26742): the crumb protects the subject, and nothing was
    protecting the crumb. A SIGKILL landing mid-write leaves a file that EXISTS and
    is short, and the recovery instruction this tool prints — `mv crumb target` —
    would then install a truncated original over a working file. The fix is the
    protection applied one level down: write elsewhere, and let rename be the only
    step that commits.

    The header carries what @nadir-codex (#26761) specified: a version, the target
    it belongs to, the payload length and its digest. Recovery that cannot check
    those has no way to tell a complete record from half of one.
    """
    payload = original.encode("utf-8")
    header = (
        f"{CRUMB_V} {target.name} {hashlib.sha256(payload).hexdigest()} "
        f"{len(payload)}\n"
    ).encode("utf-8")
    tmp = crumb.with_suffix(crumb.suffix + ".tmp")
    with open(tmp, "wb") as fh:
        fh.write(header + payload)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, crumb)
    # SURVIVING MUTANT, named rather than hidden: removing the fsync above kills no
    # test. It guards a power loss — bytes acknowledged by the OS but not on the
    # platter — and that is not observable from userspace without pulling the plug.
    # The kill-a-process probes cannot see it, and no test here claims to.
    #
    # The rename is durable only once the DIRECTORY entry is. Skipped where the
    # platform will not let us open a directory, which is stated rather than assumed.
    try:
        dfd = os.open(crumb.parent, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError:
        pass


def read_crumb(crumb: Path, target: Path) -> tuple[str | None, str]:
    """(original, state). state is `absent`, `valid`, or a reason it is CORRUPT.

    Three outcomes, never two. *Named* by @nadir-codex (#26761): a partial record
    treated as "no crumb" turns a crash into a silent skip of recovery, at exactly
    the moment recovery is the only thing left.
    """
    if not crumb.is_file():
        return None, "absent"
    raw = crumb.read_bytes()
    head, sep, payload = raw.partition(b"\n")
    if not sep:
        return None, "the record has no header line — it was cut before the newline"
    parts = head.decode("utf-8", "replace").split()
    if len(parts) != 5 or " ".join(parts[:2]) != CRUMB_V:
        return None, f"unrecognised header {head[:60]!r}"
    _, _, name, digest, length = parts
    if name != target.name:
        return None, f"the record belongs to {name}, not {target.name}"
    if not length.isdigit() or int(length) != len(payload):
        return None, (
            f"the record claims {length} payload bytes and holds {len(payload)} — "
            f"it was cut mid-write"
        )
    if hashlib.sha256(payload).hexdigest() != digest:
        return None, "the payload does not match its digest"
    return payload.decode("utf-8"), "valid"


def main(argv: list[str]) -> int:
    args = [a for a in argv[1:] if not a.startswith("--")]
    if not args:
        print(__doc__.strip().splitlines()[-2].strip(), file=sys.stderr)
        return 2
    target = Path(args[0])
    if not target.is_file():
        print(f"UNKNOWN: {target} is not a file — nothing was mutated", file=sys.stderr)
        return 2

    text = target.read_text()
    only = None
    if "--changed" in argv:
        only = changed_lines(target)
        if only is None:
            print(
                "UNKNOWN: git could not report what changed, so nothing was scoped",
                file=sys.stderr,
            )
            return 2
        if not only:
            print(
                "UNKNOWN: --changed was asked for and this file has no uncommitted "
                "changes. Nothing was mutated, which is not the same as nothing "
                "surviving.",
                file=sys.stderr,
            )
            return 2
        print(f"  scoped to {len(only)} changed line(s) vs HEAD")
    cands = candidates(text, only)
    if "--list" in argv:
        for name, before, _ in cands:
            print(f"  {name}: {before.strip()[:70]}")
        print(f"\n{len(cands)} candidate mutation(s)")
        return 0

    if len(args) < 2:
        print(
            "UNKNOWN: no test file given — nothing could be measured", file=sys.stderr
        )
        return 2
    test_file = Path(args[1])
    if not test_file.is_file():
        print(f"UNKNOWN: {test_file} is not a file", file=sys.stderr)
        return 2

    original = text
    baseline_hash = sha(target)

    # A crumb from a previous run means that run never restored the file — killed by
    # SIGKILL, a power loss, or anything else no handler can catch. Refusing is the
    # only honest move: the file on disk is a mutant, so a baseline measured on it
    # would be a baseline of somebody else's injected defect, and every verdict after
    # that is about the wrong program.
    stale = target.with_suffix(target.suffix + ".mutate-original")
    saved, state = read_crumb(stale, target)
    if state == "valid":
        print(
            f"UNKNOWN: {stale.name} holds a complete record, so a previous run was "
            f"killed before it could restore {target.name}. The file on disk may "
            f"still hold a mutant. The record is intact and verified against its "
            f"digest, so `mv {stale.name} {target.name}` restores the original "
            f"exactly; delete {stale.name} instead if the current content is what "
            f"you want. Nothing was measured.",
            file=sys.stderr,
        )
        return 2
    if state != "absent":
        # A truncated record is NOT an absent one, and it is not a usable one
        # either. Telling anyone to `mv` this over their file would install half an
        # original — the recovery path doing the damage it exists to prevent.
        print(
            f"CORRUPT: {stale.name} is a partial record — {state}. Do NOT move it "
            f"over {target.name}: it would install a truncated original. Recover "
            f"{target.name} from version control, then delete {stale.name}. Nothing "
            f"was measured.",
            file=sys.stderr,
        )
        return 2

    code, out = run_tests(test_file)
    if code != 0:
        print(
            "UNKNOWN: the baseline suite is not green, so no mutant proves anything.\n"
            + out[-800:],
            file=sys.stderr,
        )
        return 2
    total_tests = len(
        [ln for ln in out.splitlines() if ln.startswith(("ok ", "not ok "))]
    )
    print(f"  baseline: {total_tests} test(s) green in {test_file.name}\n")

    survived, killed, outcomes = [], [], []
    restored = False

    # A crumb that outlives this process. try/finally covers exceptions, including
    # the KeyboardInterrupt from Ctrl-C — it does NOT cover SIGTERM or SIGKILL.
    # Measured 2026-09-09: SIGTERM mid-run left `if True:  # mutant` in the file and
    # nothing said so. A command timeout, a cancelled CI job or a closed terminal all
    # do that, and this tool exists to be pointed at the code somebody is editing.
    #
    # So: the original is written beside the target BEFORE the first mutation and
    # removed after a verified restore. SIGTERM and SIGINT restore and re-raise;
    # SIGKILL cannot be caught, and for that the crumb is the whole defence — the
    # next run refuses to start and says exactly how to undo it.
    crumb = target.with_suffix(target.suffix + ".mutate-original")

    def restore_and_exit(signum, _frame):
        target.write_text(original)
        crumb.unlink(missing_ok=True)
        print(
            f"\n  interrupted by signal {signum} — {target.name} restored, "
            f"sha {sha(target)[:12]}",
            file=sys.stderr,
        )
        raise SystemExit(130)

    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, restore_and_exit)
    write_crumb(crumb, target, original)

    try:
        for name, before, after in cands:
            mutated = original.replace(before, after, 1)
            if mutated == original:
                continue
            target.write_text(mutated)
            if sha(target) == baseline_hash:
                print(
                    f"  SKIP  {name}: the file did not change — no conclusion",
                    file=sys.stderr,
                )
                continue
            code, _ = run_tests(test_file)
            line = original[: original.index(before)].count("\n") + 1
            entry = f"{target.name}:{line} {name} — {before.strip()[:60]}"
            outcomes.append((line, name, code != 0, before.strip()[:60]))
            (killed if code != 0 else survived).append(entry)
            print(f"  {'killed ' if code else 'SURVIVED'} {entry}")
    finally:
        # No `return` here: a return inside finally swallows whatever exception
        # brought us here, so a crash mid-run would be reported as a restore
        # failure — the wrong cause, stated confidently. Caught by ruff B012 on
        # the first lint of this file, which is the rule set chosen two cycles ago
        # earning its keep.
        target.write_text(original)
        # Restored is a fact about the file, not about the write returning.
        restored = sha(target) == baseline_hash
        if restored:
            # Only after the file is provably back. A crumb removed on the way out
            # regardless would erase the one record of an unrestored file.
            #
            # SURVIVING MUTANT, published rather than hidden: changing this to
            # `if True:` kills no test. The protection that actually fires is the
            # exception — an unwritable target raises before this line is reached,
            # so the crumb survives either way. The case this guard is for is a
            # write that RETURNS while leaving different bytes, and that cannot be
            # constructed on this filesystem. It stays because the cost is one
            # condition and the loss would be the only copy of somebody's file.
            crumb.unlink(missing_ok=True)

    if not restored:
        print("FATAL: the file was NOT restored — check it by hand", file=sys.stderr)
        return 2

    if not killed and not survived:
        print(
            "UNKNOWN: no mutation could be applied, so nothing was measured. This is "
            "not a clean sweep — widen the scope, or check that the operators reach "
            "the construct you changed.",
            file=sys.stderr,
        )
        return 2
    print(
        f"\n{len(killed)} killed, {len(survived)} survived, of {len(killed) + len(survived)}"
    )
    lopsided = one_sided(outcomes)
    if lopsided:
        print("\nONE-SIDED — the tests pin one direction of a condition, not both:")
        for entry in lopsided:
            print(f"  {entry}")
        print(
            "\nA repair that overshoots past the target passes this suite, because "
            "nothing asserts the other side. The fix is rarely a further iteration."
        )

    if survived:
        print("\nSurvived — these changes broke nothing that is asserted:")
        for s in survived:
            print(f"  {s}")
        print(
            "\nA survivor is a question, not a verdict: sometimes the mutation is "
            "behaviour nobody promised. Decide which, and say so."
        )
    return 1 if survived else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
