#!/usr/bin/env python3
"""solo-verify — one verifier for every stack. Returns a receipt, not a verdict.

Design, and who broke the first draft of it:

* One command, no stack choices in the agent's head. Checks activate from
  repository markers (Spotify's background agents work this way).

* "ok" is a forbidden word on its own. A green result that does not say what
  ran, what was skipped and *what it refused to look at* is indistinguishable
  from never having looked. Board agent @zhopych-dristun put it sharply after
  a hidden vote counter silently dropped a ballot: a silent rejection and an
  absent input are the same state to the system. So the receipt names the
  unchecked files, always.

* Zero scope is never a pass. @antigravity-scout-99 calls this the False Green
  on Zero Scope: a runner that collects 0 tests exits 0, and the agent believes
  everything is green. Nothing checked => UNKNOWN, exit 2.

* Counters, not just colour. Hiding *which tool* ran is economy; hiding *how
  many items it collected* is data loss.

* Every sensor states a PROMISE. Weakening a threshold then reads as a diff
  against a published promise instead of an invisible edit. @zhopych-dristun's
  measurement: in 3 of 5 real cases the correct repair WAS the rule, not the
  code, so the harness must make rule edits visible rather than forbid them.

* Touching the harness is reported loudly (HARNESS TOUCHED), because a blocking
  gate the agent can rewrite is a race the agent wins.

Usage:
    solo-verify                     # fast: syntax + lint on changed files
    solo-verify --full              # + types, tests
    solo-verify --files a.py b.ts   # explicit scope
    solo-verify --json              # machine-readable receipt

Exit: 0 pass or partial · 1 fail · 2 unknown (nothing was actually checked)
PARTIAL means every check that ran was green but a sensor that applied could
not run — green by what ran, not clean.
"""

# solo-verify: allow long-module — this script is distributed as ONE stdlib file a stranger curls into their own repository; splitting it would break the only thing it promises publicly. The 1000-line limit is right in general and wrong here.
from __future__ import annotations

import argparse
import ast
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import tokenize
from dataclasses import dataclass, field
from io import StringIO
from pathlib import Path

FAST_TIMEOUT = 20
FULL_TIMEOUT = 300

# Thresholds from CLAUDE.md, enforced as a sensor instead of prose, because a
# rule nobody measures is a rule the agent forgets after compaction.
MAX_FUNCTION_LINES = 150
MAX_MODULE_LINES = 1000

SOURCE_SUFFIXES = {
    ".py",
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".rs",
    ".swift",
    ".kt",
    ".kts",
    ".sh",
    ".go",
}

# Files that ARE the harness. Editing them is legitimate but must never be quiet.
HARNESS_PATTERNS = (
    "pyproject.toml",
    "ruff.toml",
    ".ruff.toml",
    "setup.cfg",
    "tox.ini",
    ".eslintrc",
    "eslint.config",
    ".pre-commit-config.yaml",
    "clippy.toml",
    ".swiftlint.yml",
    ".editorconfig",
    "solo-verify",
    "conftest.py",
    "hooks.json",
    "sensor-",
    "lefthook.yml",
    ".husky/",
)
# Matched against a path with a leading "/" so "tests/x" and "a/tests/x" both
# hit. Without that normalisation a repo-root tests/ directory was reported as
# UNCHECKED instead of as a harness edit — found by this tool on this repo.
TEST_PATTERNS = (
    "test_",
    "_test.",
    "/tests/",
    ".test.",
    ".spec.",
    "Tests.swift",
    ".bats",
)

# Fix instructions, not error codes. A sensor exists so the agent can
# self-correct; a bare rule id does not tell it how.
FIX_HINTS = {
    "F821": "Undefined name. Import or define it. Do not silence this one.",
    "F401": "Unused import. Remove it. If it is a re-export, list it in __all__.",
    "E501": "Line too long. Wrap it; do not raise the limit for a single line.",
    "long-function": (
        f"Longer than {MAX_FUNCTION_LINES} lines. Split by responsibility. "
        "Splitting is the default; keeping it whole needs a reason in the commit."
    ),
    "long-module": (
        f"Longer than {MAX_MODULE_LINES} lines. Split it. If generated or a "
        "single cohesive table, say so in the commit message."
    ),
    "syntax": "File does not parse. Fix this before anything else.",
    "types": "Type error. Fix the type rather than widening to Any. If the "
    "checker is wrong, narrow the ignore to this line, with a reason.",
}


@dataclass
class Result:
    name: str
    status: str  # pass | fail | skip
    promise: str = ""  # what this sensor claims to check
    reason: str = ""  # why skipped — mandatory for skip
    # "not-applicable" (nothing of that type in scope) or "unavailable" (the
    # sensor applied but its tool could not run). Reported by @calorik-hygiene:
    # PASS with ruff skipped reads as "lint clean" when it means "lint never ran".
    skip_kind: str = ""
    findings: list[str] = field(default_factory=list)
    covered: list[str] = field(default_factory=list)  # files it actually looked at
    counters: dict = field(default_factory=dict)  # minimal observability vector
    # Rules this scope declared it will not obey, with the stated reason. Printed
    # on every run: an exemption that stops being visible is a suppression.
    exemptions: list[str] = field(default_factory=list)
    # Over a limit with NO declaration. Not a finding about this change, and not an
    # exemption either — there is no stated reason to show. A separate list because
    # a waiver with an argument and debt without one are different facts.
    undeclared: list[str] = field(default_factory=list)
    seconds: float = 0.0


UNAVAILABLE = "unavailable"
NOT_APPLICABLE = "not-applicable"


def missing(binary: str, install_hint: str = "") -> str:
    """Why a tool is absent — three distinct states that look identical inside.

    @mcp-toolsmith's capability-inventory point: "I have no tool for that" can
    mean not-installed, installed-but-not-on-this-PATH, or present-but-broken.
    A hook runs with a different PATH than the shell, so "not installed" is
    routinely a lie told by the environment.
    """
    where = shutil.which(binary)
    if where:
        return f"{binary} found at {where} but did not run"
    hint = f" ({install_hint})" if install_hint else ""
    return (
        f"{binary} not on this process PATH{hint}. "
        f"A hook's PATH differs from your shell's — if it works in the "
        f"terminal, the tool is unreachable here, not absent."
    )


def status_for(code: int) -> str:
    """A non-zero exit is not automatically a failed check.

    Reported by the life2film session, which had this lie three times in one
    day: `timeout` is absent on macOS, so the probe exited 127 with no output
    and was read as "the test did not go red". 127/126 mean the command never
    ran; 124 means it was cut off. None of those observed the thing under test,
    so they are UNKNOWN territory, not evidence of a pass or a failure.
    """
    if code == 0:
        return "pass"
    if code in (124, 126, 127):
        return "skip"
    return "fail"


def incomplete_reason(code: int) -> str:
    return {
        124: "timed out before finishing — the check did not complete, so this "
        "is neither a pass nor a failure",
        126: "found but not executable — the check never ran",
        127: "command not found while running the check (a nested tool is "
        "missing, not the wrapper) — the check never ran",
    }.get(code, "")


# git reads these BEFORE it reads `-C` or the working directory, so a caller that
# exports them decides which repository we measure. pre-commit exports both, and so
# does any shell inside a hook. Scrubbed for every subprocess, not only for git: a
# linter that shells out to git inherits the same override.
GIT_ENV_OVERRIDES = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE")


def run(argv: list[str], cwd: Path, timeout: int) -> tuple[int, str]:
    """Run a command. Returns (code, combined output). Never raises.

    The scope of a verification comes from `git diff`, so an inherited GIT_DIR
    silently moves the whole run to another repository — and the receipt then says
    PASS about files nobody asked about. Measured: with GIT_DIR pointed at a scratch
    repo, this printed `VERIFY PASS … 1 changed file(s), 1 covered` for a file in
    that scratch repo while standing in this one.
    """
    env = {k: v for k, v in os.environ.items() if k not in GIT_ENV_OVERRIDES}
    try:
        p = subprocess.run(
            argv,
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
            env=env,
        )
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except subprocess.TimeoutExpired:
        return 124, f"timed out after {timeout}s"
    except FileNotFoundError:
        return 127, f"{argv[0]} not found"
    except OSError as exc:
        return 126, str(exc)


def git_changed_files(root: Path) -> list[Path]:
    """Changed vs HEAD, staged, and untracked. Empty if not a git repo."""
    code, _ = run(["git", "rev-parse", "--is-inside-work-tree"], root, 5)
    if code != 0:
        return []
    names: set[str] = set()
    for argv in (
        ["git", "diff", "--name-only", "--diff-filter=ACMR", "HEAD"],
        ["git", "diff", "--name-only", "--diff-filter=ACMR", "--cached"],
        ["git", "ls-files", "--others", "--exclude-standard"],
    ):
        code, out = run(argv, root, 10)
        if code == 0:
            names.update(ln.strip() for ln in out.splitlines() if ln.strip())
    return [root / n for n in sorted(names) if (root / n).is_file()]


def git_named_but_absent(root: Path) -> list[str]:
    """Paths git named that are not in the working tree.

    The list git returns is CORRECT; it was lost one line later, on `is_file()`,
    and nothing said so. That is a sharper failure than a wrong scope: a wrong scope
    is visible in the receipt, whereas a correct entry silently dropped by a filter
    leaves nothing to notice. Named by a peer session, whose pre-commit hook was
    handed `heavy.bin` by git and then resolved it against the wrong directory.

    Two causes produce this and they cannot be told apart from in here, so both are
    stated rather than one guessed: a file staged and then removed from the working
    tree, or a repository being read that is not the one on disk.
    """
    names: set[str] = set()
    for argv in (
        ["git", "diff", "--name-only", "--diff-filter=ACMR", "HEAD"],
        ["git", "diff", "--name-only", "--diff-filter=ACMR", "--cached"],
        ["git", "ls-files", "--others", "--exclude-standard"],
    ):
        code, out = run(argv, root, 10)
        if code == 0:
            names.update(ln.strip() for ln in out.splitlines() if ln.strip())

    # Two kinds of entry are NOT "named but absent", and both were false positives
    # measured before shipping rather than reasoned about:
    #
    #   a directory  — a submodule or a directory entry. This tool never claimed to
    #                  check those. 1 of 2 findings on the first run.
    #   a symlink    — a DANGLING link is present in the working tree; it simply does
    #                  not resolve. That is a different fact with a different remedy,
    #                  and calling it "git named a file that is not here" states a
    #                  cause that did not happen. Reported by a peer session who
    #                  measured 2 of 3 on their own version; 1 of 1 here, on a staged
    #                  broken symlink.
    #
    # `lexists` rather than `exists`, because `exists` follows the link and would
    # send a dangling one straight back into the list this excludes it from.
    def present(n: str) -> bool:
        f = root / n
        return f.is_file() or f.is_dir() or os.path.lexists(f)

    return sorted(n for n in names if not present(n))


def git_deleted_files(root: Path) -> list[str]:
    """Paths this change removed. Excluded from scope on purpose, named anyway.

    `--diff-filter=ACMR` above leaves out deletions, correctly: there is nothing
    left to parse. But then a change consisting only of deletions produced
    "empty scope: no changed files were found to check" — and that is false. A
    file WAS found; it is gone. Deleting a module is a real change, and telling
    its author that nothing changed is the wrong-cause defect for the third time
    in this file.
    """
    out = []
    for argv in (
        ["git", "diff", "--name-only", "--diff-filter=D", "HEAD"],
        ["git", "diff", "--name-only", "--diff-filter=D", "--cached"],
    ):
        code, res = run(argv, root, 10)
        if code == 0:
            out.extend(ln.strip() for ln in res.splitlines() if ln.strip())
    return sorted(set(out))


def detect_stacks(root: Path, files: list[Path]) -> dict[str, str]:
    markers = {
        "python": ["pyproject.toml", "setup.py", "requirements.txt"],
        "node": ["package.json"],
        "rust": ["Cargo.toml"],
        "swift": ["Package.swift"],
        "kotlin": ["build.gradle.kts", "build.gradle"],
        "go": ["go.mod"],
    }
    found: dict[str, str] = {}
    for stack, names in markers.items():
        for name in names:
            if (root / name).exists():
                found[stack] = name
                break

    # A root marker is not the only evidence a language is present. An Xcode
    # project generated from project.yml has no Package.swift, so `swift` never
    # activated and swiftlint vanished from the receipt entirely — neither ran
    # nor skipped. Reported by the life2film session on a ~220-file Swift tree.
    by_suffix = {
        ".swift": "swift",
        ".kt": "kotlin",
        ".kts": "kotlin",
        ".rs": "rust",
        ".go": "go",
        ".py": "python",
        ".ts": "node",
        ".tsx": "node",
        ".js": "node",
        ".jsx": "node",
    }
    for f in files:
        stack = by_suffix.get(f.suffix)
        if stack and stack not in found:
            found[stack] = f"changed {f.suffix} files"
    return found


def shebang(path: Path) -> str:
    """First-line interpreter, or "". Extension is not identity.

    Found by this tool on itself: `scripts/solo-verify` is Python with no .py
    suffix, so every suffix-filtered sensor silently skipped it and the receipt
    listed it as UNCHECKED. A file type guessed only from its name is a silent
    rejection waiting to happen.
    """
    try:
        with path.open("rb") as fh:
            first = fh.readline(200).decode("utf-8", errors="replace")
    except OSError:
        return ""
    return first[2:].strip() if first.startswith("#!") else ""


def is_python(path: Path) -> bool:
    return path.suffix == ".py" or "python" in shebang(path)


def is_shell(path: Path) -> bool:
    return path.suffix in {".sh", ".bash"} or any(
        sh in shebang(path) for sh in ("bash", "/sh", "zsh")
    )


def rel(root: Path, p: Path) -> str:
    try:
        return str(p.relative_to(root))
    except ValueError:
        return str(p)


ASSERTION_LINE = re.compile(
    r"^\s*(?:\[\[|\[ |assert\b|expect\(|self\.assert|EXPECT_|XCTAssert|#\[test\])"
)


def assertions_removed(root: Path, files: list[Path]) -> list[str]:
    """Test files in this change where more assertions left than arrived.

    `HARNESS TOUCHED` says a test was edited. It cannot say whether the edit was a
    repair or a retreat, and the two look identical in a diff: when a rule tightens,
    the test that encoded the old rule must change — and so must the test that is
    being weakened to keep a red gate green. Named here after tightening a rule and
    updating its test, which was correct, while noticing nothing in this receipt
    could have told the difference.

    This does not tell the difference either. It reports the SHAPE — assertions net
    negative — the way HARNESS TOUCHED reports the edit: visible next to the green
    light, judged by a person. Consolidating tests and deleting an obsolete one both
    produce it legitimately, which is exactly why it must never be a finding.
    """
    out = []
    for f in files:
        s = rel(root, f)
        if not any(pat in "/" + s for pat in TEST_PATTERNS):
            continue
        added = removed = 0
        for argv in (["git", "diff", "--", s], ["git", "diff", "--cached", "--", s]):
            code, diff = run(argv, root, 10)
            if code != 0:
                continue
            for line in diff.splitlines():
                if line.startswith("+++") or line.startswith("---"):
                    continue
                if line.startswith("+") and ASSERTION_LINE.match(line[1:]):
                    added += 1
                elif line.startswith("-") and ASSERTION_LINE.match(line[1:]):
                    removed += 1
        if removed > added:
            out.append(f"{s}: -{removed} assertions, +{added}")
    return out


def harness_touched(root: Path, files: list[Path]) -> list[str]:
    """Files in this change that ARE the measuring apparatus.

    Not a prohibition: sometimes the rule is what is wrong. But the edit has to
    be visible next to the green light, or the gate is one the agent can rewrite.
    """
    hits = []
    for f in files:
        s = rel(root, f)
        probe = "/" + s  # so "tests/x" matches the "/tests/" pattern
        if any(pat in probe for pat in HARNESS_PATTERNS) or any(
            pat in probe for pat in TEST_PATTERNS
        ):
            digest = "missing"
            try:
                digest = hashlib.sha256(f.read_bytes()).hexdigest()[:12]
            except OSError:
                pass
            hits.append(f"{s} sha256:{digest}")
    return hits


# --------------------------------------------------------------------------
# Sensors
# --------------------------------------------------------------------------


def project_python_floor(root: Path) -> tuple[int, int] | None:
    """The lowest Python this project says it supports, from requires-python.

    Measured on someone else's repository, which is the only place this could
    have been found: `phantom-agent` declares `requires-python = ">=3.14"` and
    contains an f-string with a backslash — legal since PEP 701 in 3.12. Parsed
    by the 3.11 interpreter that happened to launch this script, it produced
    `File does not parse. Fix this before anything else.` — the receipt's
    highest-priority finding, about a file that is correct.

    A false red, and worse than a false green in one way: it sends someone to fix
    working code. The sensor was never wrong about what it saw; it was wrong to
    report "this file is broken" when the honest statement is "the interpreter I
    ran under cannot parse a file written for a newer one".
    """
    for name in ("pyproject.toml", "setup.cfg"):
        f = root / name
        if not f.is_file():
            continue
        m = re.search(
            r"""^\s*(?:requires-python|python_requires)\s*=\s*["']?[^0-9]*(\d+)\.(\d+)""",
            f.read_text(errors="replace"),
            re.MULTILINE,
        )
        if m:
            return int(m.group(1)), int(m.group(2))
    return None


# Source this sensor deliberately does not parse: another sensor owns it.
NO_PARSER_HERE = {".ts", ".tsx", ".kt", ".kts", ".rs", ".go"}


def check_syntax(root: Path, files: list[Path]) -> Result:
    """Parse-only, per file, no cross-file semantics.

    @antigravity-scout-99's Intermittent Rupture: during a multi-file refactor a
    strict type check on every edit floods the agent with errors from files it
    has not reached yet, and it panics and reverts good work. Syntax is safe to
    check on every single edit because it cannot fail for that reason.
    """
    covered, findings = [], []
    running = sys.version_info[:2]
    floor = project_python_floor(root)
    # Only a project that targets a NEWER Python than the one parsing can produce
    # a syntax error that is really a version artefact. A project on an older
    # floor gets the ordinary verdict.
    newer_than_us = floor is not None and floor > running
    unparseable_by_version = []

    for f in files:
        if is_python(f):
            try:
                ast.parse(f.read_text(encoding="utf-8", errors="replace"))
                covered.append(rel(root, f))
            except SyntaxError as exc:
                if newer_than_us:
                    # Not covered: we did not check this file, and saying we did
                    # would be the false green in the other direction.
                    unparseable_by_version.append(
                        f"{rel(root, f)}:{exc.lineno or 1} {exc.msg} — parsed by "
                        f"Python {running[0]}.{running[1]}, but this project requires "
                        f">={floor[0]}.{floor[1]}. UNCHECKED, not broken: run the "
                        f"verifier under the project's own interpreter to find out."
                    )
                    continue
                covered.append(rel(root, f))
                findings.append(
                    f"{rel(root, f)}:{exc.lineno or 1} syntax {exc.msg} — {FIX_HINTS['syntax']}"
                )
            except OSError:
                pass
        elif f.suffix in {".js", ".jsx"} and shutil.which("node"):
            code, out = run(["node", "--check", str(f)], root, 10)
            covered.append(rel(root, f))
            if code != 0:
                findings.append(
                    f"{rel(root, f)} syntax {out.strip().splitlines()[0] if out.strip() else 'parse error'}"
                )
        elif f.suffix == ".swift" and shutil.which("swiftc"):
            # -parse stops before type checking, so an unknown type or a missing
            # import stays green — exactly the promise ast.parse makes for
            # Python. ~0.15s per file, so it is scoped to changed files only.
            # Contributed and measured by a peer session on its own Swift tree.
            code, out = run(["swiftc", "-parse", str(f)], root, 20)
            covered.append(rel(root, f))
            if status_for(code) == "fail":
                first = next(
                    (ln.strip() for ln in out.splitlines() if ": error:" in ln),
                    "parse error",
                )
                findings.append(f"{rel(root, f)} syntax {first}")
    if unparseable_by_version and not covered:
        return Result(
            "syntax",
            "skip",
            reason=(
                f"every file in scope failed to parse under Python "
                f"{running[0]}.{running[1]} while the project requires "
                f">={floor[0]}.{floor[1]} — nothing was checked"
            ),
            skip_kind=UNAVAILABLE,
            findings=unparseable_by_version,
            # Without this counter the receipt's NOT CHECKED section filters these
            # findings out and the files are never NAMED — the promise in
            # rules/harness-sensors.md is "NOT CHECKED, named, with both versions",
            # and it was kept only when SOME file in scope still parsed. When the
            # whole scope failed on version, the reason said "every file in scope"
            # and no filename appeared anywhere in the receipt or the JSON.
            #
            # That is the fixture pack's case 2 — the one a stranger is asked to
            # run — and it was found by running our own pack under a second
            # interpreter rather than by reading this branch.
            counters={"unchecked_needs_newer_python": len(unparseable_by_version)},
        )

    # This must precede the generic branch below. It did not, so when a
    # version-unparseable file was the ONLY file in scope, `covered` was empty and
    # the generic "no parseable files in scope" won — leaving the version branch
    # unreachable and the receipt stating a cause that did not happen.
    #
    # The test written for this two days ago used TWO files, so `covered` was
    # never empty and the ordering never mattered. Found by a fixture pack built
    # for an outside agent, on its first run, because a fixture is one file per
    # case by design.
    if not covered:
        # "No parseable files in scope" states a cause that did not happen when
        # the scope holds source this sensor has no parser for. A .ts file is not
        # an absence of source; it is source TypeScript owns and this sensor does
        # not. Same defect as reporting a named-but-unresolved file as "no changed
        # files were found".
        unparsed_kinds = sorted({f.suffix for f in files if f.suffix in NO_PARSER_HERE})
        reason = (
            f"no parser here for {', '.join(unparsed_kinds)} — tsc and eslint own "
            f"TypeScript, this sensor covers .py/.js/.swift"
            if unparsed_kinds
            else "no parseable files in scope"
        )
        return Result(
            "syntax",
            "skip",
            reason=reason,
            skip_kind=NOT_APPLICABLE,
        )
    counters = {
        "parsed": len(covered),
        "broken": len(findings),
        # Which interpreter did the parsing. The receipt never said, and that is
        # exactly the fact needed to read a syntax finding on someone else's tree.
        "python": f"{running[0]}.{running[1]}",
    }
    if unparseable_by_version:
        counters["unchecked_needs_newer_python"] = len(unparseable_by_version)
    return Result(
        "syntax",
        "fail" if findings else "pass",
        promise="every changed .py/.js/.swift file parses (syntax only, not types)",
        # These ride in findings so the file is named. A counter saying "1" without
        # saying which file is the same shape as a verdict without a receipt.
        findings=findings + unparseable_by_version,
        covered=covered,
        counters=counters,
    )


def previous_size(root: Path, path: Path) -> tuple[int, int] | None:
    """(lines, longest function) of this file at HEAD, or None if it is new.

    Measured need: run on click's last commit, `limits` produced five findings
    and all five were pre-existing size — core.py at 3839 lines, a test file at
    3656. Nobody splits a mature library's core because a verifier asked, so an
    unconditional threshold is 100% unactionable on someone else's tree. The
    threshold is only a signal when THIS change crossed it.
    """
    rel_path = rel(root, path)
    code, out = run(["git", "show", f"HEAD:{rel_path}"], root, 10)
    if code != 0:
        return None
    lines = out.count("\n") + 1
    longest = 0
    if path.suffix == ".py":
        try:
            tree = ast.parse(out)
        except SyntaxError:
            return (lines, 0)
        for node in ast.walk(tree):
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                end = getattr(node, "end_lineno", None)
                if end:
                    longest = max(longest, end - node.lineno + 1)
    return (lines, longest)


EXEMPT_RE = re.compile(
    # `[^\S\n]*` after the dash, not `\s*`: `\s*` consumes the newline, so a
    # declaration with NO reason matched the NEXT LINE of the file and the receipt
    # printed somebody's `import os` as the argument for waiving a rule. A
    # mechanism that exists to stop a rule being set aside without an argument was
    # inventing the argument. Found while writing the same regex a second time.
    # Whitespace REQUIRED on both sides of the separator. Without it the regex
    # backtracks and uses the hyphen inside the rule name as the dash: `allow
    # long-module —` parsed as rule=`long`, why=`module —`, so a declaration with
    # no reason was honoured anyway. Two holes in one line, and the second only
    # showed up after the first was fixed.
    r"^#[^\S\n]*solo-verify:[^\S\n]*allow[^\S\n]+(?P<rule>[a-z-]+)[^\S\n]+[—-]"
    r"[^\S\n]+(?P<why>\S.*)$",
    re.MULTILINE,
)


def declared_exemptions(text: str, python: bool = False) -> dict[str, str]:
    """Rules this file declares it will not obey, and the reason for each.

    A threshold sometimes conflicts with a property the code is *for*. This file
    is 1449 lines against a 1000-line limit, and splitting it would break the one
    thing it promises publicly: a single stdlib script a stranger can curl into
    their own repository. The limit is right in general and wrong here.

    The two ways that usually gets resolved are both bad. Raising the threshold
    loses the signal everywhere. Committing past the finding every time turns the
    gate into a formality — it is the first entry in this harness's own list of
    bypasses, and a bypass taken habitually is indistinguishable from no gate.

    So the exemption is declared in the file, must carry a reason, and is printed
    in the receipt on **every** run. It is not a suppression: nothing gets
    quieter, the finding is replaced by a standing statement that someone chose
    this and said why. A reader who disagrees can see it without reading the code.

        # solo-verify: allow long-module — reason, in the present tense

    An `allow` with no reason is not honoured and is reported as its own finding:
    a rule waived without an argument is the thing this mechanism exists to avoid.
    """
    if python:
        # Tokenize, so only a REAL comment counts. Found one hour after shipping
        # this: a file whose docstring merely showed the syntax at column 0 was
        # exempting itself — the mechanism could not tell documentation from a
        # decision. Its own docstring above escaped that by being indented, which
        # is luck rather than design.
        #
        # Third time this shape has bitten this week: bats rewriting `@test`
        # inside a heredoc, a vitest fixture inside a .bats file read as tests,
        # and now prose read as a directive. A scanner that matches text cannot
        # tell content from instruction; one that reads the grammar can.
        try:
            found = {}
            for tok in tokenize.generate_tokens(StringIO(text).readline):
                if tok.type != tokenize.COMMENT:
                    continue
                m = EXEMPT_RE.match(tok.string.strip())
                if m:
                    found[m.group("rule")] = m.group("why").strip()
            return found
        except (tokenize.TokenError, IndentationError, SyntaxError):
            # An unparseable file has no honoured exemptions. The syntax sensor
            # owns that failure; here it must not become a free pass.
            return {}
    # No tokenizer for the other languages, so the weaker rule: a declaration
    # about the whole file must sit in its first 40 lines. That still cannot see
    # inside a block comment, and the limit of the guarantee is stated rather
    # than implied.
    head = "\n".join(text.splitlines()[:40])
    return {m.group("rule"): m.group("why").strip() for m in EXEMPT_RE.finditer(head)}


def check_limits(root: Path, files: list[Path]) -> Result:
    findings, covered, exempt, undeclared = [], [], [], []
    for f in files:
        if f.suffix not in SOURCE_SUFFIXES and not (is_python(f) or is_shell(f)):
            continue
        try:
            text = f.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        covered.append(rel(root, f))
        allowed = declared_exemptions(text, python=is_python(f))
        for rule, why in allowed.items():
            if not why or why.lower() in ("todo", "tbd", "later"):
                findings.append(
                    f"{rel(root, f)}:1 exemption for {rule!r} carries no reason. "
                    f"A rule waived without an argument is what this mechanism exists "
                    f"to prevent; state why, in the present tense, or remove it."
                )
        n = text.count("\n") + 1
        before = previous_size(root, f)
        if "long-module" in allowed and allowed["long-module"]:
            # Loud, every run, and never a skip: the reader sees the choice and
            # the reason without opening the file.
            exempt.append(
                f"{rel(root, f)} long-module ({n} lines) — {allowed['long-module']}"
            )
        elif n > MAX_MODULE_LINES and (before is None or before[0] <= MAX_MODULE_LINES):
            findings.append(
                f"{rel(root, f)}:1 long-module {n} lines — {FIX_HINTS['long-module']}"
            )
        elif (
            "long-module" not in allowed
            and before is not None
            and before[0] > MAX_MODULE_LINES
            and n > before[0]
        ):
            findings.append(
                f"{rel(root, f)}:1 long-module grew {before[0]} -> {n} lines, already over "
                f"{MAX_MODULE_LINES}. Not your debt, but this change adds to it."
            )
        elif n > MAX_MODULE_LINES and "long-module" not in allowed:
            # Already over and not growing: correctly NOT a finding about this
            # change, and it was also silent — the only way to learn a file sat
            # over the limit undeclared was to write a one-off script, which is
            # how these two were found. Its own list, NOT the exempt one: a waiver
            # with a stated reason and debt with none are different facts, and the
            # first draft put them under a header reading "declared in the file,
            # with the reason given there" over an entry saying it was not.
            undeclared.append(f"{rel(root, f)} long-module ({n} lines)")
        if not is_python(f):
            continue
        try:
            tree = ast.parse(text)
        except SyntaxError:
            continue  # syntax sensor owns this
        for node in ast.walk(tree):
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                end = getattr(node, "end_lineno", None)
                if not end:
                    continue
                length = end - node.lineno + 1
                if length <= MAX_FUNCTION_LINES:
                    continue
                # Pre-existing over-length functions are inherited debt, not a
                # finding about this change.
                if before is not None and before[1] >= length:
                    continue
                findings.append(
                    f"{rel(root, f)}:{node.lineno} long-function {node.name}() is "
                    f"{length} lines — {FIX_HINTS['long-function']}"
                )
    if not covered:
        return Result(
            "limits",
            "skip",
            reason="no source files in scope",
            skip_kind=NOT_APPLICABLE,
        )
    return Result(
        "limits",
        "fail" if findings else "pass",
        promise=(
            f"no function >{MAX_FUNCTION_LINES} lines, no module >{MAX_MODULE_LINES} "
            f"lines — about THIS change: a file already over the limit is inherited "
            f"debt, reported but not failed"
        ),
        findings=findings,
        covered=covered,
        counters={
            "files": len(covered),
            **({"exempt": len(exempt)} if exempt else {}),
            **({"over_undeclared": len(undeclared)} if undeclared else {}),
        },
        exemptions=exempt,
        undeclared=undeclared,
    )


def unparsed_guard(code, out, findings, counters, counter_name):
    """A tool that failed but whose output nobody could parse did not find nothing.

    The receipt's whole job is that a number and a status agree. `fail` beside
    `violations: 0` says both "something is wrong" and "nothing was found", and a
    reader cannot tell whether the tool found zero problems and failed for some
    other reason, or whether the parser recognised none of its output. Measured
    here: ruff emitted five `invalid-syntax` diagnostics on a file that was not
    Python, the coded-only pattern matched none of them, and the receipt printed
    `violations: 0` with one finding reading "ruff failed".

    So a non-zero exit with an empty finding list is now reported as what it is —
    a parser gap — with the tool's own last lines attached, and the counter says
    `unparsed` rather than claiming zero. Zero is a measurement; "I did not
    understand the answer" is not one.

    Prompted by @slav-tbilisi-assistant's rule on the board: a tool that acts on
    the property it measures is uniquely prone to exhibiting it, so its degenerate
    input is the first test case rather than the last. This verifier reports on
    whether checks report honestly, and it was not reporting honestly.
    """
    if code == 0 or findings or incomplete_reason(code):
        return findings, counters
    tail = [line.strip() for line in out.splitlines() if line.strip()][-5:]
    return (
        [f"exit {code}, but no finding could be parsed from its output:"] + tail,
        {**counters, counter_name: "unparsed"},
    )


# Which files mean "this repository chose its own rules for that tool". A tool
# with no entry here has no configuration to choose (gofmt is canonical), or its
# strictness is a flag we pass ourselves and the promise says so.
TOOL_CONFIG = {
    "swiftlint": (".swiftlint.yml", ".swiftlint.yaml"),
    "ktlint": (".editorconfig",),
    "rustfmt": ("rustfmt.toml", ".rustfmt.toml"),
}


def tool_is_configured(root: Path, tool: str) -> bool:
    """Did THIS repository choose the rules, or is it getting the tool's defaults?

    The generalisation of ruff_is_configured below, and it took an outside
    argument to see it. On the board, an agent writing in mock-imperial Russian
    ruled against his own court: *no crown, realm or office gives legal force to
    an event in someone else's thread; a foreign charter is read literally and
    obeyed by its owner's letter.* Under the costume that is exactly our defect —
    giving a tool's default opinion the standing of the repository's choice.

    Measured: swiftlint on a repo with no .swiftlint.yml reports
    `identifier_name` for `let x`, a rule those authors never adopted, under a
    promise that read "swiftlint rules".
    """
    return any((root / name).is_file() for name in TOOL_CONFIG.get(tool, ()))


def ruff_is_configured(root: Path) -> bool:
    """Does this repository actually choose its own ruff rules?

    The sensor's published promise is "the repo's configured ruff rule set". On a
    repository that configures nothing, that sentence is false, and measurably so:
    ruff 0.16 with no config reports S110 and BLE001 alongside F, while the same
    file under an explicit `select = ["E4","E7","E9","F"]` reports only F — 8
    findings against 4 on one probe file.

    Found while measuring the false-positive rate on four foreign checkouts, none
    of which configures ruff. 107 violations were reported against a standard
    their authors never adopted, under a promise saying otherwise. The findings
    are not deleted — some are real — but the receipt must stop claiming they were
    measured against the repository's own rules.

    Ruff also reads a user-level config, so the answer is repo-scoped on purpose:
    it asks what THIS project chose, not what this machine happens to impose.
    """
    for name in ("ruff.toml", ".ruff.toml"):
        if (root / name).is_file():
            return True
    for name in ("pyproject.toml", "setup.cfg"):
        f = root / name
        if f.is_file() and re.search(
            r"^\s*\[tool\.ruff", f.read_text(errors="replace"), re.M
        ):
            return True
    return False


def check_ruff(root: Path, files: list[Path], timeout: int) -> Result:
    py = [f for f in files if is_python(f)]
    if not py:
        return Result(
            "ruff", "skip", reason="no Python files in scope", skip_kind=NOT_APPLICABLE
        )
    if not shutil.which("ruff"):
        return Result(
            "ruff",
            "skip",
            reason=missing("ruff", "brew install ruff"),
            skip_kind=UNAVAILABLE,
        )
    t = time.time()
    code, out = run(
        ["ruff", "check", "--no-fix", "--output-format=concise", *[str(f) for f in py]],
        root,
        timeout,
    )
    findings = []
    for line in out.splitlines():
        line = line.strip()
        # concise format is "path:line:col: CODE message" — anything else is
        # a summary line, and counting it would make the counter disagree
        # with the status.
        m = re.match(r"^.+?:\d+:\d+: ([A-Z]{1,4}\d{2,4})\b", line)
        if m:
            hint = FIX_HINTS.get(m.group(1))
            findings.append(f"{line} — {hint}" if hint else line)
            continue
        # Not every ruff diagnostic carries a rule code. `invalid-syntax:` does not,
        # and on a file that is not Python at all ruff emits nothing else. The
        # coded-only pattern matched none of them, so the receipt printed
        # `violations: 0` beside status `fail` — a failure reporting no findings,
        # which is the exact unreadable receipt this tool exists to prevent.
        if re.match(r"^.+?:\d+:\d+: \S", line):
            findings.append(line)
    configured = ruff_is_configured(root)
    counters = {
        "files": len(py),
        "violations": len(findings),
        # Whose standard produced that number. Without this the receipt claimed the
        # repository's own rules while applying ruff's defaults to a repository
        # that had chosen none.
        "rules": "repo" if configured else "ruff-defaults",
    }
    findings, counters = unparsed_guard(code, out, findings, counters, "violations")
    if not configured and findings:
        findings = [
            "NOTE: this repository configures no ruff rules, so the findings below "
            "are ruff's defaults, not a standard its authors adopted. Real defects "
            "may be among them; treat the count as unactionable until someone here "
            "chooses a rule set."
        ] + findings
    return Result(
        "ruff",
        status_for(code),
        reason=incomplete_reason(code),
        skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
        promise=(
            "ruff rule set configured for this repo"
            if configured
            else "ruff's own defaults — this repo configures no rule set"
        ),
        findings=findings[:20],
        covered=[rel(root, f) for f in py],
        counters=counters,
        seconds=time.time() - t,
    )


def check_types(root: Path, files: list[Path], timeout: int) -> Result:
    py = [f for f in files if is_python(f)]
    if not py:
        return Result(
            "ty", "skip", reason="no Python files in scope", skip_kind=NOT_APPLICABLE
        )
    if not shutil.which("uvx"):
        return Result("ty", "skip", reason=missing("uvx"), skip_kind=UNAVAILABLE)
    t = time.time()
    code, out = run(["uvx", "ty", "check", *[str(f) for f in py]], root, timeout)
    findings = [ln.strip() for ln in out.splitlines() if "error" in ln.lower()][:15]
    if findings:
        findings.append(FIX_HINTS["types"])
    return Result(
        "ty",
        status_for(code),
        reason=incomplete_reason(code),
        skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
        promise="type errors in changed Python files",
        findings=findings,
        covered=[rel(root, f) for f in py],
        counters={"files": len(py)},
        seconds=time.time() - t,
    )


def check_pytest(root: Path, timeout: int) -> Result:
    """Reports collected/passed/failed, never a bare colour.

    Zero collected is not a pass — that is the False Green on Zero Scope.
    """
    if not ((root / "tests").is_dir() or any(root.glob("test_*.py"))):
        return Result(
            "pytest",
            "skip",
            reason="no tests/ directory and no test_*.py at root",
            skip_kind=NOT_APPLICABLE,
        )
    if not shutil.which("uvx"):
        return Result("pytest", "skip", reason=missing("uvx"), skip_kind=UNAVAILABLE)
    t = time.time()
    code, out = run(["uvx", "pytest", "-q", "--no-header"], root, timeout)
    # Order matters: a timed-out or never-started run parses as "0 collected",
    # and reporting that as "no tests found" states the wrong cause. Check
    # completion before interpreting the output at all.
    if status_for(code) == "skip":
        return Result(
            "pytest",
            "skip",
            reason=incomplete_reason(code),
            skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
            seconds=time.time() - t,
        )
    counters = {"collected": 0, "passed": 0, "failed": 0}
    for key, pat in (
        ("passed", r"(\d+) passed"),
        ("failed", r"(\d+) failed"),
        ("collected", r"(\d+) tests? collected"),
    ):
        m = re.search(pat, out)
        if m:
            counters[key] = int(m.group(1))
    if not counters["collected"]:
        counters["collected"] = counters["passed"] + counters["failed"]
    if counters["collected"] == 0:
        return Result(
            "pytest",
            "fail",
            promise="the repo's test suite runs and passes",
            findings=[
                (
                    "collected 0 tests. Exit code alone would read as green; it is "
                    "not. Possible causes: test paths, renamed files, a broken "
                    "conftest — but pytest's own words are below and beat the guess."
                ),
                # Measured on a conftest that raises: pytest printed the file, the
                # line and `RuntimeError: conftest explodes`, and the receipt threw
                # all of it away for a three-item checklist. A hint is a hypothesis;
                # the tool's output is evidence, and evidence goes in the receipt.
                *[ln.strip() for ln in out.splitlines() if ln.strip()][-6:],
            ],
            counters=counters,
            seconds=time.time() - t,
        )
    tail = [ln for ln in out.splitlines() if ln.strip()][-10:]
    return Result(
        "pytest",
        status_for(code),
        reason=incomplete_reason(code),
        skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
        promise="the repo's test suite runs and passes",
        findings=[] if code == 0 else tail,
        counters=counters,
        seconds=time.time() - t,
    )


def check_go(root: Path, files: list[Path], full: bool, timeout: int) -> list[Result]:
    """Requested by @antigravity-wanderer, who had a Go project to test on.

    gofmt is the fast sensor: it parses, so it doubles as a syntax check and
    cannot fail because of a file the agent has not reached yet. vet and test
    are semantic and stay in full mode.
    """
    src = [f for f in files if f.suffix == ".go"]
    if not shutil.which("go"):
        return [
            Result(
                "go",
                "skip",
                reason=missing("go", "brew install go"),
                skip_kind=UNAVAILABLE,
            )
        ]

    results: list[Result] = []
    if not src:
        results.append(
            Result(
                "gofmt", "skip", reason="no Go files in scope", skip_kind=NOT_APPLICABLE
            )
        )
    else:
        t = time.time()
        code, out = run(["gofmt", "-l", *[str(f) for f in src]], root, timeout)
        unformatted = [ln.strip() for ln in out.splitlines() if ln.strip()]
        results.append(
            Result(
                "gofmt",
                "fail" if unformatted else "pass",
                promise="every changed .go file parses and is gofmt-clean",
                findings=[
                    f"{Path(f).name} — not gofmt-clean. Run `gofmt -w {f}`."
                    for f in unformatted[:20]
                ],
                covered=[rel(root, f) for f in src],
                counters={"files": len(src), "unformatted": len(unformatted)},
                seconds=time.time() - t,
            )
        )

    if full:
        t = time.time()
        code, out = run(["go", "vet", "./..."], root, timeout)
        findings = [
            ln.strip()
            for ln in out.splitlines()
            if ln.strip() and not ln.startswith("#")
        ][:15]
        # Measured with a Go module that does not compile: go-vet printed a bare
        # `fail` with no counter. go-test in the same run did produce findings,
        # because Go emits FAIL lines even on a build failure — so cargo-test's
        # defect is not shared here, and this is the only half that needed fixing.
        findings, counters = unparsed_guard(
            code, out, findings, {"diagnostics": len(findings)}, "diagnostics"
        )
        results.append(
            Result(
                "go-vet",
                status_for(code),
                reason=incomplete_reason(code),
                skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
                promise="go vet clean across the module",
                findings=findings,
                counters=counters,
                seconds=time.time() - t,
            )
        )

        t = time.time()
        code, out = run(["go", "test", "./..."], root, timeout)
        if status_for(code) == "skip":
            results.append(
                Result(
                    "go-test",
                    "skip",
                    reason=incomplete_reason(code),
                    skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
                    seconds=time.time() - t,
                )
            )
            return results
        # Counters, not a bare colour: "no test files" everywhere is the Go
        # shape of a False Green on Zero Scope.
        ok = len(re.findall(r"^ok\s+", out, re.MULTILINE))
        notests = len(re.findall(r"no test files", out))
        failed = len(re.findall(r"^(FAIL|---\s+FAIL)", out, re.MULTILINE))
        counters = {"packages_ok": ok, "packages_no_tests": notests, "failed": failed}
        if code == 0 and ok == 0 and notests > 0:
            results.append(
                Result(
                    "go-test",
                    "fail",
                    promise="the module's tests run and pass",
                    findings=[
                        (
                            f"{notests} package(s) reported 'no test files' and none ran "
                            "a test. Exit 0 means nothing was asserted, not that it passed."
                        )
                    ],
                    counters=counters,
                    seconds=time.time() - t,
                )
            )
        else:
            tail = [
                ln.strip()
                for ln in out.splitlines()
                if ln.startswith(("FAIL", "---", "panic:"))
            ][:15]
            results.append(
                Result(
                    "go-test",
                    status_for(code),
                    reason=incomplete_reason(code),
                    skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
                    promise="the module's tests run and pass",
                    findings=tail if code != 0 else [],
                    counters=counters,
                    seconds=time.time() - t,
                )
            )
    return results


def check_shellcheck(root: Path, files: list[Path], timeout: int) -> Result:
    sh = [f for f in files if is_shell(f)]
    if not sh:
        return Result(
            "shellcheck",
            "skip",
            reason="no shell files in scope",
            skip_kind=NOT_APPLICABLE,
        )
    if not shutil.which("shellcheck"):
        return Result(
            "shellcheck",
            "skip",
            reason=missing("shellcheck", "brew install shellcheck"),
            skip_kind=UNAVAILABLE,
        )
    t = time.time()
    code, out = run(
        ["shellcheck", "--severity=warning", *[str(f) for f in sh]], root, timeout
    )
    findings = [ln.strip() for ln in out.splitlines() if ln.strip()][:20]
    return Result(
        "shellcheck",
        status_for(code),
        reason=incomplete_reason(code),
        skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
        # The severity floor is a flag we pass, not the repo's choice, and the
        # receipt is what gets read — the caveat lived only in the rules file.
        promise="shell scripts clean at shellcheck severity >= warning (our threshold)",
        findings=findings,
        covered=[rel(root, f) for f in sh],
        counters={"files": len(sh)},
        seconds=time.time() - t,
    )


def check_node_lint(root: Path, files: list[Path], timeout: int) -> Result:
    src = [f for f in files if f.suffix in {".ts", ".tsx", ".js", ".jsx"}]
    if not src:
        return Result(
            "eslint", "skip", reason="no JS/TS files in scope", skip_kind=NOT_APPLICABLE
        )
    binary = root / "node_modules" / ".bin" / "eslint"
    if not binary.exists():
        # UNAVAILABLE, not a bare skip: eslint APPLIED — there are JS/TS files in
        # scope — and its tool could not run. Without the kind the verdict came
        # out PASS on a TypeScript file with a type error, which is the exact
        # false green @calorik-hygiene reported for ruff. The rule was written and
        # only ruff was wired to it.
        return Result(
            "eslint",
            "skip",
            reason="node_modules/.bin/eslint absent — run pnpm install",
            skip_kind=UNAVAILABLE,
        )
    t = time.time()
    code, out = run([str(binary), *[str(f) for f in src]], root, timeout)
    findings = [ln.strip() for ln in out.splitlines() if ln.strip()][:20]
    return Result(
        "eslint",
        status_for(code),
        reason=incomplete_reason(code),
        skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
        promise="eslint config for this repo",
        findings=findings,
        covered=[rel(root, f) for f in src],
        counters={"files": len(src)},
        seconds=time.time() - t,
    )


def check_tsc(root: Path, timeout: int) -> Result:
    binary = root / "node_modules" / ".bin" / "tsc"
    if not binary.exists():
        # Same shape as eslint above: it applied and could not run.
        return Result(
            "tsc", "skip", reason="typescript not installed", skip_kind=UNAVAILABLE
        )
    t = time.time()
    code, out = run([str(binary), "--noEmit"], root, timeout)
    findings = [ln.strip() for ln in out.splitlines() if "error TS" in ln][:15]
    counters = {"errors": len(findings)}
    # Measured, not assumed: with no tsconfig.json, `tsc --noEmit` prints its
    # version banner and exits non-zero. No line contains "error TS", so the
    # receipt read `tsc=fail {"errors":0}` with the single finding "tsc failed" —
    # a failure claiming to have found nothing, in the last parsing sensor the
    # guard had never reached.
    #
    # Six other sensors parse output without it and were checked the same way:
    # shellcheck keeps every non-empty line, ty matches any line containing
    # "error", pytest attaches its own tail. Whether a pair needs the guard is a
    # property of the pair, not of the code shape — the same reason go-test did
    # not need it.
    findings, counters = unparsed_guard(code, out, findings, counters, "errors")
    return Result(
        "tsc",
        status_for(code),
        reason=incomplete_reason(code),
        skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
        promise="project typechecks",
        findings=findings,
        counters=counters,
        seconds=time.time() - t,
    )


def rust_edition(root: Path) -> str:
    try:
        m = re.search(
            r'^\s*edition\s*=\s*"(\d{4})"',
            (root / "Cargo.toml").read_text(encoding="utf-8", errors="replace"),
            re.MULTILINE,
        )
        return m.group(1) if m else "2024"
    except OSError:
        return "2024"


def check_rust(root: Path, files: list[Path], full: bool, timeout: int) -> list[Result]:
    if not shutil.which("cargo"):
        return [Result("cargo", "skip", reason=missing("cargo"), skip_kind=UNAVAILABLE)]
    out_results = []

    # `cargo fmt --check` formats the whole workspace regardless of what
    # changed. On a project that never adopted rustfmt that is 93 files of
    # noise on every run, and — worse — it reported a finding in the same
    # receipt that said "empty scope: nothing was verified". Two contradictory
    # statements in one receipt. Scope it to the changed files instead.
    rs = [f for f in files if f.suffix == ".rs"]
    if not rs:
        out_results.append(
            Result(
                "cargo-fmt",
                "skip",
                reason="no Rust files in scope",
                skip_kind=NOT_APPLICABLE,
            )
        )
    elif not shutil.which("rustfmt"):
        out_results.append(
            Result(
                "cargo-fmt", "skip", reason=missing("rustfmt"), skip_kind=UNAVAILABLE
            )
        )
    else:
        t = time.time()
        code, _ = run(
            [
                "rustfmt",
                "--check",
                "--edition",
                rust_edition(root),
                *[str(f) for f in rs],
            ],
            root,
            timeout,
        )
        out_results.append(
            Result(
                "cargo-fmt",
                status_for(code),
                reason=incomplete_reason(code),
                skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
                promise=(
                    "changed .rs files match this repo's rustfmt.toml"
                    if tool_is_configured(root, "rustfmt")
                    else "changed .rs files match rustfmt's default style (this repo sets none)"
                ),
                findings=[]
                if code == 0
                else [
                    f"{rel(root, f)} — not rustfmt-clean. Run `rustfmt {rel(root, f)}`."
                    for f in rs
                ],
                covered=[rel(root, f) for f in rs],
                counters={"files": len(rs)},
                seconds=time.time() - t,
            )
        )
    if full:
        t = time.time()
        code, out = run(
            ["cargo", "clippy", "--all-targets", "--", "-D", "warnings"], root, timeout
        )
        findings = [
            ln.strip() for ln in out.splitlines() if ln.startswith(("error", "warning"))
        ][:15]
        # A bare `clippy=fail` with no counter is "ok" alone wearing red. Same rule.
        findings, counters = unparsed_guard(
            code, out, findings, {"diagnostics": len(findings)}, "diagnostics"
        )
        out_results.append(
            Result(
                "clippy",
                status_for(code),
                reason=incomplete_reason(code),
                skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
                promise="clippy with warnings denied (whole workspace, not scoped)",
                findings=findings,
                counters=counters,
                seconds=time.time() - t,
            )
        )
        t = time.time()
        code, out = run(["cargo", "test", "--quiet"], root, timeout)
        m = re.search(r"(\d+) passed.*?(\d+) failed", out)
        counters = {"passed": int(m.group(1)), "failed": int(m.group(2))} if m else {}
        findings = [
            ln.strip() for ln in out.splitlines() if "FAILED" in ln or "panicked" in ln
        ][:15]
        # Measured: a crate that does not compile produces neither FAILED nor
        # panicked, so this filter returned nothing and the receipt printed a bare
        # `cargo-test=fail` with the two-word finding "cargo-test failed" — the exact
        # shape ruff had. The suite did not fail a test; it never ran one.
        findings, counters = unparsed_guard(code, out, findings, counters, "failed")
        out_results.append(
            Result(
                "cargo-test",
                status_for(code),
                reason=incomplete_reason(code),
                skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
                promise="cargo test suite passes (whole workspace, not scoped)",
                findings=findings,
                counters=counters,
                seconds=time.time() - t,
            )
        )
    return out_results


def check_swift(root: Path, files: list[Path], timeout: int) -> Result:
    src = [f for f in files if f.suffix == ".swift"]
    if not src:
        return Result(
            "swiftlint",
            "skip",
            reason="no Swift files in scope",
            skip_kind=NOT_APPLICABLE,
        )
    if not shutil.which("swiftlint"):
        return Result(
            "swiftlint",
            "skip",
            reason=missing("swiftlint", "brew install swiftlint"),
            skip_kind=UNAVAILABLE,
        )
    t = time.time()
    code, out = run(
        ["swiftlint", "lint", "--quiet", *[str(f) for f in src]], root, timeout
    )
    # swiftlint prints the path it was given, and it is given absolute paths. A
    # receipt is meant to be pasted — onto a board, into an issue — so an absolute
    # path leaks the operator's directory layout to whoever reads it. Every other
    # sensor reports through rel(); this one did not, and it is the only one whose
    # output is verbatim from the tool.
    findings = [
        ln.strip() for ln in out.splitlines() if ": error:" in ln or ": warning:" in ln
    ][:20]
    counters = {
        "files": len(src),
        "violations": len(findings),
        "rules": "repo" if tool_is_configured(root, "swiftlint") else "tool-defaults",
    }
    findings, counters = unparsed_guard(code, out, findings, counters, "violations")
    return Result(
        "swiftlint",
        # The exit code was discarded here, so a timeout or a missing binary
        # produced empty output, no findings, and `pass` — a false green on the
        # one path where nothing ran at all.
        status_for(code),
        reason=incomplete_reason(code),
        skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
        promise=(
            "swiftlint rules configured for this repo"
            if tool_is_configured(root, "swiftlint")
            else "swiftlint's own defaults — this repo configures no rule set"
        ),
        findings=findings,
        covered=[rel(root, f) for f in src],
        counters=counters,
        seconds=time.time() - t,
    )


def check_kotlin(root: Path, files: list[Path], timeout: int) -> Result:
    src = [f for f in files if f.suffix in {".kt", ".kts"}]
    if not src:
        return Result(
            "ktlint",
            "skip",
            reason="no Kotlin files in scope",
            skip_kind=NOT_APPLICABLE,
        )
    if not shutil.which("ktlint"):
        return Result(
            "ktlint",
            "skip",
            reason=missing("ktlint", "brew install ktlint"),
            skip_kind=UNAVAILABLE,
        )
    t = time.time()
    code, out = run(["ktlint", *[str(f) for f in src]], root, timeout)
    findings = [ln.strip() for ln in out.splitlines() if ln.strip()][:20]
    return Result(
        "ktlint",
        status_for(code),
        reason=incomplete_reason(code),
        skip_kind=UNAVAILABLE if incomplete_reason(code) else "",
        promise=(
            "ktlint rules configured for this repo"
            if tool_is_configured(root, "ktlint")
            else "ktlint's own defaults — this repo configures no rule set"
        ),
        findings=findings,
        covered=[rel(root, f) for f in src],
        counters={"files": len(src)},
        seconds=time.time() - t,
    )


# --------------------------------------------------------------------------
# Receipt
# --------------------------------------------------------------------------


# A sensor promised for a file type in scope must appear in the receipt in SOME
# state. Silence is the one outcome that is never allowed: on a Swift tree,
# `swiftlint` was installed and reachable yet appeared in neither `ran` nor
# `skipped`, because the stack never activated. Absence of a line read as
# "nothing to say" when it meant "this sensor was never constructed".
# Proposed by the life2film session: a sensor missing from both lists is a
# defect of the harness, not a missing line.
EXPECTED_SENSORS = {
    ".swift": "swiftlint",
    ".kt": "ktlint",
    ".kts": "ktlint",
    ".rs": "cargo-fmt",
    ".go": "gofmt",
    ".py": "ruff",
    ".ts": "eslint",
    ".tsx": "eslint",
    ".js": "eslint",
    ".jsx": "eslint",
    ".sh": "shellcheck",
}


def harness_gaps(files: list[Path], results: list[Result]) -> list[str]:
    """File types in scope whose promised sensor never appeared at all."""
    spoke = {r.name for r in results}
    # a stack-level skip (e.g. "cargo", "go") answers for its own sensors
    aliases = {"cargo-fmt": "cargo", "gofmt": "go"}
    gaps = []
    for suffix in sorted({f.suffix for f in files}):
        sensor = EXPECTED_SENSORS.get(suffix)
        if not sensor:
            continue
        if sensor in spoke or aliases.get(sensor, "") in spoke:
            continue
        n = sum(1 for f in files if f.suffix == suffix)
        gaps.append(
            f"{n} {suffix} file(s) in scope but '{sensor}' said nothing — "
            f"neither ran nor skipped. This is a harness defect, not a clean result."
        )
    return gaps


def build_receipt(
    root: Path,
    files: list[Path],
    stacks: dict[str, str],
    results: list[Result],
    full: bool,
    elapsed: float,
    unresolved: list[str] | None = None,
    deleted: list[str] | None = None,
    absent: list[str] | None = None,
) -> dict:
    ran = [r for r in results if r.status in ("pass", "fail")]
    failed = [r for r in ran if r.status == "fail"]

    covered: set[str] = set()
    for r in ran:
        covered.update(r.covered)

    scope = [rel(root, f) for f in files]
    # Named rejections: changed files no sensor looked at. A silent drop and an
    # absent input must not be the same state.
    unchecked = [s for s in scope if s not in covered]

    # A sensor that had work to do and could not do it. Distinct from one that had
    # nothing to look at, and the difference decides the verdict.
    unavailable = [
        r for r in results if r.status == "skip" and r.skip_kind == "unavailable"
    ]

    if not scope:
        verdict = "UNKNOWN"
        if unresolved:
            why = (
                "empty scope: none of the named files could be resolved — "
                + ", ".join(unresolved)
            )
        elif absent:
            why = (
                f"empty scope: git named {len(absent)} file(s) that are not in the "
                f"working tree ({', '.join(absent[:5])}) and nothing else changed. A "
                f"file WAS found; it could not be read, which is not the same as "
                f"nothing having changed."
            )
        elif deleted:
            why = (
                f"empty scope: this change only removes files ({len(deleted)}: "
                f"{', '.join(deleted[:5])}{', …' if len(deleted) > 5 else ''}). There is "
                f"nothing left to parse, which is expected — but nothing was verified "
                f"either, and callers that removed code should say so rather than cite a "
                f"green run."
            )
        else:
            why = "empty scope: no changed files were found to check"
    elif not ran:
        verdict, why = "UNKNOWN", "no sensor could run on this scope"
    elif failed:
        verdict, why = "FAIL", ""
    elif harness_gaps(files, results):
        verdict, why = "UNKNOWN", "a promised sensor never reported (see HARNESS GAP)"
    elif absent:
        # A correct list, lost by a filter. Not PASS: files this change touched were
        # never opened, and a green verdict would be about the ones that happened to
        # survive the filter.
        verdict, why = (
            "PARTIAL",
            (
                f"git named {len(absent)} file(s) that are not in the working tree "
                f"({', '.join(absent[:5])}{', …' if len(absent) > 5 else ''}) — they "
                f"were NOT checked. Either they were staged and then removed, or the "
                f"repository being read is not the one on disk; from in here those "
                f"two look identical, so both are stated rather than one guessed."
            ),
        )
    elif unavailable:
        # Not PASS. The same file with two ruff violations returns FAIL where ruff
        # is installed and PASS where it is not — an absent tool turning red into
        # green. @nirmata measured this on an outside seat, @calorik-hygiene named
        # it: "PASS with ruff skipped is not 'clean', it is 'lint never ran'".
        verdict, why = (
            "PARTIAL",
            (
                f"{len(unavailable)} applicable sensor(s) could not run — "
                f"this is not a clean result, it is an incomplete one"
            ),
        )
    else:
        verdict, why = "PASS", ""

    rec = {
        "verdict": verdict,
        "why": why,
        "mode": "full" if full else "fast",
        "root": str(root),
        "stacks": stacks,
        "scope": scope,
        "covered": sorted(covered),
        "unchecked": unchecked,
        "harness_touched": harness_touched(root, files),
        "assertions_removed": assertions_removed(root, files),
        "harness_gaps": harness_gaps(files, results),
        "named_but_absent": absent or [],
        "ran": [
            {
                "name": r.name,
                "status": r.status,
                "promise": r.promise,
                "counters": r.counters,
                "seconds": round(r.seconds, 2),
            }
            for r in ran
        ],
        "skipped": [
            {"name": r.name, "reason": r.reason, "kind": r.skip_kind}
            for r in results
            if r.status == "skip"
        ],
        "unavailable": [r.name for r in unavailable],
        "exemptions": [e for r in results for e in r.exemptions],
        "over_undeclared": [u for r in results for u in r.undeclared],
        # A passing sensor's findings are never rendered, so a file it declined to
        # check would leave only a counter behind. Named here instead.
        "not_checked_version": [
            f
            for r in results
            if r.counters.get("unchecked_needs_newer_python")
            for f in r.findings
            if "UNCHECKED, not broken" in f
        ],
        # Relativised in one place rather than in each sensor. Eight of them hand
        # absolute paths to their tool, and whether the tool echoes the path as
        # given or relativises it is the tool's choice, not ours — swiftlint
        # echoes it. A receipt is meant to be pasted onto a board or into an
        # issue, so an absolute path publishes the operator's directory layout to
        # whoever reads it. Fixing it per sensor would be seven more call sites
        # to forget; the same lesson the skip_kind audit produced.
        "findings": [
            f.replace(f"{root.resolve()}/", "")
            for r in failed
            for f in (r.findings or [f"{r.name} failed"])
        ],
        "elapsed": round(elapsed, 2),
    }
    rec["verdict_digest"] = verdict_digest(rec)
    return rec


TIMING_FIELDS = ("elapsed", "seconds")


def verdict_digest(rec: dict) -> str:
    """sha256 of everything in this receipt except how long it took.

    Two runs on the same tree already differed only in `elapsed` and each sensor's
    `seconds` — measured, four lines of diff. But nothing CHECKED that: if a future
    change let set-iteration order into `scope`, or a temp path into a finding, the
    receipt would quietly stop being comparable and no test would notice.

    So the property is a field rather than a claim. It answers "did anything about
    the verdict change between these two runs" with one comparison, which matters
    most for the reader who does not know which of our fields vary — the same reader
    the fixture pack is written for.

    JSON only, deliberately: the text receipt is for reading and a hash in it would
    be noise on every run.
    """

    def strip(o):
        if isinstance(o, dict):
            return {k: strip(v) for k, v in sorted(o.items()) if k not in TIMING_FIELDS}
        if isinstance(o, list):
            return [strip(v) for v in o]
        return o

    payload = json.dumps(strip(rec), sort_keys=True, ensure_ascii=False)
    return hashlib.sha256(payload.encode()).hexdigest()[:16]


def witness_available(root: str) -> bool:
    """Is the tool that answers this question actually here?

    Naming a command that is not present is worse than silence: the reader spends
    the trust once, finds nothing, and discounts the next pointer too. solo-verify
    is distributed as a single file people curl on its own, so `scripts/witness`
    beside it is the exception rather than the rule.
    """
    return (Path(root) / "scripts" / "witness").is_file()


def render(rec: dict) -> str:
    out = [f"VERIFY {rec['verdict']} ({rec['mode']}, {rec['elapsed']}s)"]
    if rec["why"]:
        out.append(f"  why:      {rec['why']}")
    out.append(
        "  stacks:   "
        + (", ".join(f"{k} ({v})" for k, v in rec["stacks"].items()) or "none detected")
    )
    out.append(
        f"  scope:    {len(rec['scope'])} changed file(s), {len(rec['covered'])} covered"
    )
    ran = rec["ran"]
    if ran:
        parts = []
        for r in ran:
            c = r["counters"]
            tail = " " + json.dumps(c, separators=(",", ":")) if c else ""
            parts.append(f"{r['name']}={r['status']}{tail}")
        out.append("  ran:      " + ", ".join(parts))
    else:
        out.append("  ran:      nothing")
    if rec["unchecked"]:
        out.append(
            "  UNCHECKED (no sensor looked at these): "
            + ", ".join(rec["unchecked"][:12])
        )
    # A passing sensor's findings are not rendered below, so anything it declined
    # to check would vanish with only a counter to mark it. Name the files.
    if rec.get("exemptions"):
        out.append("  EXEMPT — declared in the file, with the reason given there:")
        for e in rec["exemptions"]:
            out.append(f"    {e}")
    if rec.get("over_undeclared"):
        out.append("  OVER A LIMIT, UNDECLARED — inherited debt, not this change:")
        for u in rec["over_undeclared"]:
            out.append(f"    {u}")
        out.append(
            "    Nothing here says why it is allowed. Declare it with a reason or "
            "split it; this run does not fail on it."
        )
    if rec.get("not_checked_version"):
        out.append("  NOT CHECKED — this interpreter is older than the project:")
        for line in rec["not_checked_version"]:
            out.append(f"    {line}")
    if rec.get("harness_gaps"):
        out.append("  HARNESS GAP — a sensor that should have spoken did not:")
        for g in rec["harness_gaps"]:
            out.append(f"    {g}")
    if rec["harness_touched"]:
        out.append("  HARNESS TOUCHED — this change edits the measuring apparatus:")
        for h in rec["harness_touched"][:10]:
            out.append(f"    {h}")
        out.append(
            "    Legitimate when the rule was wrong. Say which promise changed and why."
        )
    if rec.get("assertions_removed"):
        out.append("  ASSERTIONS NET NEGATIVE — more left these tests than arrived:")
        for a in rec["assertions_removed"][:10]:
            out.append(f"    {a}")
        out.append(
            "    A repair and a retreat look identical in a diff: when a rule tightens"
        )
        out.append(
            "    the test encoding the old rule must change, and so must a test being"
        )
        out.append(
            "    weakened to keep a red gate green. This says which SHAPE it is, not"
        )
        out.append("    which one it was. Consolidation produces it legitimately too.")
        # The tool that answers the remaining question exists and nothing pointed
        # at it. Two cycles ago the same gap made a shipped checker sit unrun for
        # days while being cited as the answer to a residual — a tool nobody is
        # told about is a tool nobody runs. Only printed where the question is
        # actually open, so it is a pointer rather than an advert.
        if witness_available(rec.get("root", ".")):
            out.append(
                "    To answer it: scripts/witness --subject <impl> --test <file> "
                "--name <test> --guard <the line the change added>"
            )
    if rec["skipped"]:
        out.append(
            "  skipped:  "
            + "; ".join(f"{s['name']} — {s['reason']}" for s in rec["skipped"])
        )
    if rec["findings"]:
        out.append("  findings:")
        for f in rec["findings"][:25]:
            out.append(f"    {f}")
        if len(rec["findings"]) > 25:
            out.append(f"    ... and {len(rec['findings']) - 25} more")
    if rec.get("unavailable"):
        out.append(
            "  INCOMPLETE — these sensors applied but could not run: "
            + ", ".join(rec["unavailable"])
        )
        out.append(
            "    A green result here means 'nothing found by what ran', not 'clean'."
        )
    if rec["verdict"] == "UNKNOWN":
        out.append(
            "  NOTE: this is NOT a pass. Nothing was verified. Either widen the "
            "scope, install the missing tools, or state plainly that the change "
            "is unverified."
        )
    return "\n".join(out)


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="solo-verify", description="Verify a change and print a receipt."
    )
    ap.add_argument("--full", action="store_true", help="also run types and tests")
    ap.add_argument(
        "--files", nargs="*", help="explicit scope (default: changed vs HEAD)"
    )
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--root", default=os.environ.get("CLAUDE_PROJECT_DIR") or ".")
    args = ap.parse_args()

    root = Path(args.root).resolve()
    timeout = FULL_TIMEOUT if args.full else FAST_TIMEOUT
    started = time.time()
    files: list[Path] = []

    unresolved: list[str] = []
    deleted = [] if args.files else git_deleted_files(root)
    absent = [] if args.files else git_named_but_absent(root)
    if args.files:
        # A path named on the command line and then silently dropped is the worst
        # kind of empty scope: the receipt went on to say "no changed files were
        # found to check", which is a cause that did not happen. The caller named
        # files; they did not resolve. Same class as reporting a timed-out test run
        # as "no tests found" — the verdict was right and the reason was invented.
        # Relative paths resolve against --root, not the caller's cwd, which is
        # what made this visible: the tests pass --root and a bare filename.
        for f in args.files:
            cand = Path(f)
            if not cand.is_absolute():
                cand = root / f
            if cand.is_file():
                files.append(cand.resolve())
            elif Path(f).is_file():
                files.append(Path(f).resolve())
            else:
                unresolved.append(f)
    else:
        files = git_changed_files(root)

    stacks = detect_stacks(root, files)
    results: list[Result] = [check_syntax(root, files), check_limits(root, files)]

    if "python" in stacks:
        results.append(check_ruff(root, files, timeout))
        if args.full:
            results.append(check_types(root, files, timeout))
            results.append(check_pytest(root, timeout))
    if "node" in stacks:
        results.append(check_node_lint(root, files, timeout))
        if args.full:
            results.append(check_tsc(root, timeout))
    if "rust" in stacks:
        results += check_rust(root, files, args.full, timeout)
    if "swift" in stacks:
        results.append(check_swift(root, files, timeout))
    if "kotlin" in stacks:
        results.append(check_kotlin(root, files, timeout))
    if "go" in stacks:
        results += check_go(root, files, args.full, timeout)
    results.append(check_shellcheck(root, files, timeout))

    rec = build_receipt(
        root,
        files,
        stacks,
        results,
        args.full,
        time.time() - started,
        unresolved,
        deleted,
        absent,
    )
    print(json.dumps(rec, indent=2, ensure_ascii=False) if args.json else render(rec))
    return {"PASS": 0, "PARTIAL": 0, "FAIL": 1, "UNKNOWN": 2}[rec["verdict"]]


if __name__ == "__main__":
    sys.exit(main())
