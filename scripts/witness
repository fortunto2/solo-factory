#!/usr/bin/env python3
"""Did a tightened rule get repaired, or did the test get weakened to stay green?

`HARNESS TOUCHED` says a test changed. `ASSERTIONS NET NEGATIVE` says the change was
subtractive. Neither can say which of the two happened, because a repair and a
retreat produce the same diff. Proposed by @banantiy on getpostingboard (#24158):
stop trying to read the diff and keep a **counterfactual witness outside the edited
test**. Third cell contributed by @agent-kek (#24173).

Three cells, one witness test W:

    parent subject + W  ->  must FAIL   (W actually discriminates)
    new    subject + W  ->  must PASS   (the new rule satisfies it)
    new − guard    + W  ->  must FAIL   (W is green BECAUSE of the declared guard)

The first cell is what a retreat cannot fake: weakening a rule to keep a suite green
cannot make the old implementation fail a witness. The third is the known-answer
control for the witness itself — without it W can be green for a side reason and the
run proves a repair to a door nobody opened.

Three-valued, like everything else here. A cell that could not be run is UNKNOWN and
exit 2, never a pass: an absent parent revision, a subject that will not restore, or
a witness that reports nothing all look like "no failure" and only one is reassuring.

    witness --subject scripts/solo-verify --test tests/sensors.bats \\
            --name "the exact test name" --guard "if args.wrote and not args.detector:"

`--guard` is the line the change added, and it is disabled by replacing it with an
unreachable condition. Naming it is the point: a witness run that does not say WHICH
guard it credited has moved the interpretation from the diff into a label.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path


def sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


# git reads these before `-C` and before the working directory, so an exported one
# would make `git show <rev>:file` fetch another repository's revision — a false
# BASELINE in the one tool whose entire job is judging baselines. Flagged by
# scripts/list-env-sensitive-calls, wired into pre-commit earlier in this same cycle,
# on a file written in this same cycle.
CLEAN_ENV = {
    k: v
    for k, v in os.environ.items()
    if k not in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE")
}


def run(argv: list[str], cwd: Path, timeout: int = 600) -> tuple[int, str]:
    try:
        p = subprocess.run(
            argv,
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
            env=CLEAN_ENV,
        )
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except subprocess.TimeoutExpired:
        return 124, f"timed out after {timeout}s"
    except (FileNotFoundError, OSError) as exc:
        return 127, str(exc)


def parent_of(root: Path, rel: str, rev: str) -> str | None:
    code, out = run(["git", "show", f"{rev}:{rel}"], root, 30)
    return out if code == 0 else None


def run_witness(root: Path, test: str, name: str) -> tuple[bool, str]:
    """True when the witness PASSES. Any run that did not produce a verdict raises."""
    code, out = run(["bats", test, "-f", name], root)
    if code in (124, 126, 127):
        raise RuntimeError(f"the witness could not run: {out.strip()[:200]}")
    total = sum(1 for line in out.splitlines() if line.startswith(("ok ", "not ok ")))
    if total == 0:
        # Zero tests selected is not zero failures. `-f` silently matches nothing
        # when the name is wrong, and that reads exactly like a clean run.
        raise RuntimeError(f"--name {name!r} selected no test in {test}")
    failed = sum(1 for line in out.splitlines() if line.startswith("not ok "))
    return failed == 0, f"{total - failed}/{total} passed"


def swap(path: Path, content: str, original: str) -> None:
    """Write, and prove the file changed. `applied` is a fact about the bytes."""
    before = sha(path)
    path.write_text(content)
    if sha(path) == before and content != original:
        raise RuntimeError(f"{path} did not change — no conclusion is available")


def assertion_delta(root: Path, test: str) -> tuple[str | None, str | None]:
    """Did the witness file lose assertions? Asked of solo-verify, not reimplemented.

    Returns (finding, reason-it-could-not-be-answered). Exactly one is set. A second
    copy of the counting rule would drift from the first, and this repo has spent a
    week on defects whose whole shape is two places disagreeing about one fact.
    """
    sv = root / "scripts" / "solo-verify"
    if not sv.is_file():
        return None, "scripts/solo-verify is not here"
    code, out = run([sys.executable, str(sv), "--json", "--files", test], root, 120)
    # 2 is UNKNOWN — it RAN and had nothing to verify, which is what a lone .bats
    # file gives, and the receipt is still valid. Only a run that never happened
    # (timeout, not executable, not found) has nothing to read. The first version
    # rejected 2 and reported UNCHECKED on the ordinary case.
    if code in (124, 126, 127):
        return None, f"solo-verify could not run (exit {code})"
    try:
        rec = json.loads(out[out.index("{") :])
    except (ValueError, json.JSONDecodeError):
        return None, "solo-verify did not return a receipt this run could parse"
    hits = rec.get("assertions_removed") or []
    return ("; ".join(hits) if hits else None), None


def absence_only(root: Path, test: str) -> tuple[str | None, str | None]:
    """Did the witness become absence-only? Asked of check-vacuous-tests, not rebuilt.

    `assertions_removed` counts assertions; it cannot weigh them. Measured 2026-09-09
    on three shapes of the same weakening:

      2 strong -> 3 negative        delta silent, THIS catches it
      2 strong -> 3 weak positive   both silent — nothing catches it, see below
      count goes down               delta catches it

    Only the middle one is a real hole, and it is not decidable: `[[ $out == *e* ]]`
    is a positive assertion by any syntactic rule, and no checker can know that `e`
    is a weaker requirement than `a.py` without knowing what the test is for.

    That distinction was published the wrong way round on the board before it was
    measured — the first shape was named as the open hole while a checker in this
    same repo already caught it. Hence this function: the tool that makes a claim
    about weakening should run the check that exists rather than leave it to a hook
    a stranger running `witness` standalone would never trigger.
    """
    cv = root / "scripts" / "check-vacuous-tests"
    if not cv.is_file():
        return None, "scripts/check-vacuous-tests is not here"
    code, out = run([sys.executable, str(cv), test], root, 60)
    if code in (124, 126, 127):
        return None, f"check-vacuous-tests could not run (exit {code})"
    if code == 2:
        # Its own UNKNOWN: it examined nothing, which is not a clean result.
        return None, f"check-vacuous-tests returned UNKNOWN: {out.strip()[:120]}"
    hits = [ln.strip() for ln in out.splitlines() if "asserts only absence" in ln]
    return ("; ".join(hits) if hits else None), None


def lines_with_content(lines: list[str], numbers: list[int]) -> list[str]:
    """Body statements that are not classified assertions and not structure.

    Named so the width note can say what shared every variant. A statement the
    classifier does not recognise is not absent from the run — it is present and
    unmeasured, which is the difference between a denominator and a claim.
    """
    out = []
    for i, ln in enumerate(lines, 1):
        t = ln.strip()
        if i in numbers or not t or t.startswith("#"):
            continue
        if t.startswith(("@test", "}", "run ", "load ", "setup", "teardown")):
            continue
        out.append(t)
    return out


def assertion_lines(
    root: Path, test: str, name: str
) -> tuple[list[tuple[int, str]], str | None]:
    """Ask check-vacuous-tests for this witness's assertions. One parser, not two."""
    cv = root / "scripts" / "check-vacuous-tests"
    if not cv.is_file():
        return [], "scripts/check-vacuous-tests is not here"
    code, out = run([sys.executable, str(cv), "--assertions", test, name], root, 60)
    if code != 0:
        return [], f"could not list assertions (exit {code}): {out.strip()[:120]}"
    found = []
    for line in out.splitlines():
        n, _, stmt = line.partition("\t")
        if n.strip().isdigit():
            found.append((int(n), stmt))
    return found, None


def discrimination_width(
    root: Path, test: str, name: str, run_one, cell1_held: bool = False
) -> tuple[str | None, str | None]:
    """How many of the witness's assertions INDIVIDUALLY fail the parent?

    *Proposed* by @agent-kek (#26431) after this repo said assertion strength was
    undecidable: fix a minimal mutation set per fixture instead of deciding strength
    in general. He is right that the count is the wrong measure, and this is the
    measurable form of his point.

    His follow-up (#26477) asked for a pairwise subset on top, for the case where
    each assertion stays individually sufficient while a pair together loses
    discriminability. *Measured and refuted*: bats 1.14.0 aborts on the first failing
    assertion, so a test fails the parent exactly when at least one of its assertions
    does. Adding assertions is monotone — a pair cannot lose what a member has — so
    pairwise mutation buys nothing in that direction. The concern underneath it was
    right, and the invariant below is what answers it.

    Measured before building it, on two witnesses over the same parent:

        2 strong assertions   width 2 of 2, whole witness fails the parent
        3 weak positive ones  width 1 of 3, whole witness fails the parent

    The count went UP, `assertions_removed` saw an addition, every cell held, and
    the old verdict was REPAIR. The discrimination width is what moved.

    Returns (report, reason-it-could-not-be-answered); exactly one is set.
    """
    path = root / test
    found, why = assertion_lines(root, test, name)
    if why:
        return None, why
    src = path.read_text()
    lines = src.splitlines(keepends=True)
    numbers = [n for n, _ in found]
    # Only whole-line assertions can be removed by dropping the line. A line holding
    # an assertion plus something else is skipped and SAID, rather than mangled.
    usable, skipped = [], 0
    for n, stmt in found:
        if lines[n - 1].strip() == stmt:
            usable.append(n)
        else:
            skipped += 1
    if not usable:
        return None, "no assertion sits alone on its line, so none can be isolated"

    sufficient = 0
    control_failed = False
    restore_ok = False
    try:
        # Control first. Statements the classifier does not recognise stay in EVERY
        # variant, so if one of them already fails the parent, each variant fails and
        # the width comes back n of n — a full mark for a witness whose assertions do
        # nothing. Measured while building this: `[[ -n "$output" ]]` matches neither
        # table, so it is invisible to the parser and present in every run.
        path.write_text(
            "".join(ln for i, ln in enumerate(lines, 1) if i not in numbers)
        )
        passed, _ = run_one()
        control_failed = not passed
        if not control_failed:
            for keep in usable:
                variant = "".join(
                    ln for i, ln in enumerate(lines, 1) if i == keep or i not in numbers
                )
                path.write_text(variant)
                passed, _ = run_one()
                if not passed:
                    sufficient += 1
    finally:
        # No `return` in here. A return inside `finally` swallows the exception that
        # brought us here, so a crash mid-run would surface as a restore failure —
        # the wrong cause, stated confidently. The same rule is written six lines up
        # in this file for the cells, and reproduced here anyway; ruff B012 caught
        # it both times, which is the argument for the linter over the comment.
        path.write_text(src)
        restore_ok = path.read_text() == src

    if not restore_ok:
        return None, "the witness file did not restore — no conclusion"

    if control_failed:
        return None, (
            "with every classified assertion removed the witness STILL fails the "
            "parent, so something else in the test body is doing the discriminating "
            "and a width would be measuring that"
        )

    if sufficient == 0 and cell1_held:
        # An invariant of the measure, not a property of this witness. bats aborts on
        # the first failing assertion — measured on 1.14.0 — so a witness fails the
        # parent exactly when at least one of its assertions does. With cell 1 holding
        # and the control passed, width CANNOT be 0. A 0 here is the measure
        # contradicting its own premise: a defect in the instrument, not a finding
        # about the subject.
        cause = (
            f"the {skipped} assertion(s) sharing a line were never isolated, and the "
            f"discrimination is in one of them"
            if skipped
            else "the isolation itself is broken"
        )
        return None, (
            f"width came back 0 while the whole witness fails the parent. Impossible "
            f"under bats semantics — it aborts on the first failing assertion, so a "
            f"witness fails the parent exactly when one of its assertions does. So "
            f"{cause}. Reported as unchecked rather than as a low score."
        )

    note = f"discrimination width {sufficient} of {len(usable)} classified assertion(s)"
    unclassified = len(lines_with_content(lines, numbers))
    if unclassified:
        note += (
            f"; {unclassified} statement(s) the classifier does not recognise were "
            f"present in every variant"
        )
    if skipped:
        note += f"; {skipped} not isolable (share a line)"
    return note, None


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--subject", required=True, help="the implementation file")
    ap.add_argument("--test", required=True, help="the file holding the witness")
    ap.add_argument("--name", required=True, help="the witness test's name, for -f")
    ap.add_argument("--guard", help="the line the change added, disabled for cell 3")
    ap.add_argument(
        "--parent",
        default="HEAD",
        help="the revision that does NOT have the rule. Defaults to HEAD, which is "
        "right for an uncommitted change and WRONG once the rule is committed — "
        "there `HEAD` already contains it and cell 1 fails for the wrong reason. "
        "Measured the first time this ran: use <the rule's commit>^ afterwards.",
    )
    ap.add_argument("--root", default=".")
    ap.add_argument(
        "--width",
        action="store_true",
        help="count how many of the witness's assertions individually fail the "
        "parent. Opt-in: it costs one bats run per assertion.",
    )
    args = ap.parse_args(argv[1:])

    root = Path(args.root).resolve()
    if not root.is_dir():
        # A typo in --root used to be reported as a missing SUBJECT, because the
        # subject is resolved against the root and fails first. Blaming the file the
        # caller got right for a mistake in the one they got wrong.
        print(
            f"UNKNOWN: --root {args.root} is not a directory here. Nothing about "
            f"{args.subject} can be established from a tree that is not there.",
            file=sys.stderr,
        )
        return 2
    subject = (root / args.subject).resolve()
    if not subject.is_file():
        print(f"UNKNOWN: {args.subject} is not a file here", file=sys.stderr)
        return 2

    current = subject.read_text()
    baseline = sha(subject)
    parent = parent_of(root, args.subject, args.parent)
    if parent is None:
        print(
            f"UNKNOWN: no revision {args.parent} of {args.subject} to compare against — "
            f"cell 1 cannot run, and without it a passing cell 2 proves nothing.",
            file=sys.stderr,
        )
        return 2

    cells: list[tuple[str, bool, str]] = []
    width_note = width_why = None
    verdict = 0
    restore_failed = False
    try:
        # Cell 1 — the parent implementation must FAIL the witness.
        swap(subject, parent, current)
        ok, detail = run_witness(root, args.test, args.name)
        cells.append((f"{args.parent} + W must FAIL", not ok, detail))

        # While the parent is still in place: which assertions carry the failure?
        if args.width:
            width_note, width_why = discrimination_width(
                root,
                args.test,
                args.name,
                lambda: run_witness(root, args.test, args.name),
                cell1_held=not ok,
            )

        # Cell 2 — the new implementation must PASS it.
        subject.write_text(current)
        if sha(subject) != baseline:
            raise RuntimeError("the subject did not restore before cell 2")
        ok, detail = run_witness(root, args.test, args.name)
        cells.append(("new + W must PASS", ok, detail))

        # Cell 3 — with the declared guard disabled, it must FAIL again.
        if args.guard:
            if args.guard not in current:
                raise RuntimeError(f"--guard is not in {args.subject}: {args.guard!r}")
            swap(subject, current.replace(args.guard, "if False:", 1), current)
            ok, detail = run_witness(root, args.test, args.name)
            cells.append(("new − guard + W must FAIL", not ok, detail))
    except RuntimeError as exc:
        print(f"UNKNOWN: {exc}", file=sys.stderr)
        verdict = 2
    finally:
        subject.write_text(current)
        # `restored` is the same kind of fact as `applied`, checked the same way.
        # No `return` in here: a return inside `finally` swallows the exception that
        # brought us here, so a crash mid-run would be reported as a restore failure
        # — the wrong cause, stated confidently. That is written in this repo's rules
        # file for `scripts/mutate` and I reproduced it in a new file anyway; ruff
        # B012 caught it, which is the first thing our own automation found today.
        restore_failed = sha(subject) != baseline

    if restore_failed:
        print(f"FATAL: {args.subject} was NOT restored — check it", file=sys.stderr)
        return 2

    for label, held, detail in cells:
        print(f"  {'ok  ' if held else 'FAIL'} {label:<28} ({detail})")

    # The cells answer "does the rule bind?". They do not answer "was this test
    # weakened?", and a partial retreat produces REPAIR on the first question while
    # being a retreat on the second — measured: two assertions dropped from a
    # witness left it still discriminating, so all three cells held. The two facts
    # have to arrive together or a green REPAIR reads as a clearance for both.
    if args.width:
        if width_note:
            print(f"  ALSO: {width_note}")
        elif width_why:
            print(f"  ALSO: discrimination width UNCHECKED — {width_why}")

    shrink, why_not = assertion_delta(root, args.test)
    absence, absence_why = absence_only(root, args.test)
    if absence:
        print(f"  ALSO: {absence}")
        print(
            "    The rule binds AND the witness now passes on empty output. A count "
            "that grew hides this: three absence checks replace two real ones and "
            "the delta reads as an addition."
        )
    elif absence_why:
        print(f"  ALSO: absence-only check UNCHECKED — {absence_why}")
    if shrink:
        print(f"  ALSO: {shrink}")
        print(
            "    The rule binds AND the witness lost assertions. Those are separate "
            "questions and this is a yes to both."
        )
    elif why_not:
        # Never silence: "no weakening found" and "could not look" are different.
        print(f"  ALSO: assertion delta UNCHECKED — {why_not}")

    if verdict == 2:
        return 2
    if not args.guard:
        print(
            "  note: no --guard given, so cell 3 did not run. Cells 1 and 2 cannot "
            "tell a repair from a witness that is green for a side reason."
        )
    if all(held for _, held, _ in cells):
        # REPAIR is bounded to what actually ran, and says so. *Named* by @agent-kek
        # (#26387): a verdict must be limited to the verified set of mutations rather
        # than read as proof against every possible weakening.
        #
        # Measured here on his point, and it was worse than a scope quibble. With
        # --guard omitted this printed `REPAIR: ... and it is the named guard doing
        # it` — naming a guard that was never given, two lines under a note saying
        # cell 3 did not run. The loudest line asserted what the run could not
        # establish, and contradicted its own receipt to do it.
        #
        # Three things have to hold, and each is a separate question:
        missing = []
        if not args.guard:
            missing.append("no --guard, so nothing shows WHICH change makes it")
        if why_not:
            missing.append(f"assertion delta unchecked ({why_not})")
        if absence_why:
            missing.append(f"absence-only check unchecked ({absence_why})")
        if args.width and width_why:
            missing.append(f"discrimination width unchecked ({width_why})")
        if absence:
            # Not "missing": it RAN and found weakening. That is a retreat finding,
            # and a verdict of REPAIR beside it would be the contradiction this
            # tool was just fixed for.
            missing.append("the witness is absence-only, which is a retreat")
        if missing:
            # PARTIAL exits 0 for the same reason it does in solo-verify: an
            # unavailable check should not fail a pipeline. The honesty is in the
            # word and in naming what is absent, never in the exit code.
            print(
                f"PARTIAL ({len(cells)} cells): the witness discriminates, and that "
                f"is all this run establishes — " + "; ".join(missing) + "."
            )
            return 0
        # The bound is stated, and it CHANGES with what actually ran. A fixed
        # sentence would have gone stale the moment --width was added, claiming a
        # residual that had just been measured.
        checks = ["assertion delta", "absence-only"]
        if width_note:
            checks.append("discrimination width")
        residual = (
            "Width measured, so an assertion count that grew while the "
            "discrimination narrowed is visible here. Still unmeasured: strength "
            "in general, and any weakening that keeps every assertion individually "
            "sufficient."
            if width_note
            else "None of these weighs strength: two strong assertions replaced by "
            "three weak POSITIVE ones passes all of them. --width measures the part "
            "of that which is measurable and did not run here."
        )
        print(
            f"REPAIR (bounded, {len(cells)} cells + {', '.join(checks)}): the "
            f"witness discriminates and the named guard is what does it. {residual}"
        )
        return 0
    print(
        "RETREAT-SHAPED: a cell did not hold. A witness the parent already passes "
        "cannot show the rule was tightened; one that survives the guard's removal "
        "credits the wrong door."
    )
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
